#!/usr/bin/env bash
#
# Root-owned production deployment entry point for the Docker Compose VPS.
#
# Deployment actions deliberately accept an immutable full Git SHA; the only
# non-deploy action accepts a fixed alert-routing label. The script keeps
# runtime secrets in /opt/monexus/.env and clones application source into a
# separate release directory, and changes the server, web, and production-only
# monitoring containers. PostgreSQL, Redis and MinIO are never recreated.

set -Eeuo pipefail
IFS=$'\n\t'

readonly REPOSITORY_URL='https://github.com/amo0114/MoNexus.git'
readonly BASE_PATH='/opt/monexus'
readonly ENV_FILE="${BASE_PATH}/.env"
readonly RELEASE_ROOT='/opt/monexus-releases'
readonly STATE_ROOT='/opt/monexus-deployments'
readonly PROJECT_NAME='monexus-prod'
readonly LOCK_FILE='/var/lock/monexus-compose-deploy.lock'
readonly HEALTH_TIMEOUT_SECONDS=180
readonly MONITORING_READY_TIMEOUT_SECONDS=120
readonly VPS_PROXY_OVERLAY_KEY='MONEXUS_USE_VPS_PROXY_OVERLAY'
readonly MONITORING_SECRET_DIR='/opt/monexus-monitoring/secrets'
readonly MONITORING_CONFIG_DIR='/opt/monexus-monitoring/config'
readonly MONITORING_REHEARSAL_ALERT='MoNexusProductionEmailRehearsal'
readonly ALERTMANAGER_IMAGE='prom/alertmanager:v0.30.0@sha256:abb750ac7b63116761c16dd481ae92496fbe04721686c0920f0fa4d0728cd4a6'
readonly PROMETHEUS_IMAGE='prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996'

fail() {
  echo "[ERROR] $*" >&2
  exit 1
}

notice() {
  # Keep progress messages out of command substitutions such as
  # release_path="$(prepare_release_source ...)".
  echo "[INFO] $*" >&2
}

usage() {
  cat <<'USAGE'
Usage:
  monexus-compose-deploy {dry-run|deploy} <40-character-master-commit-sha>
  monexus-compose-deploy rehearse-alert {value-policy-p0|value-policy-p1}

dry-run validates the request and prints its immutable image tag without
changing the host. deploy verifies the master ancestry and image labels,
updates only MONEXUS_IMAGE_TAG/MONEXUS_PULL_POLICY, recreates server then web,
then recreates the private monitoring services and verifies their targets and
rules. rehearse-alert sends fixed firing/resolved test alerts and requires two
successful email notification attempts. No action performs automatic rollback.
USAGE
}

require_root() {
  [[ "${EUID}" -eq 0 ]] || fail 'This deployment entry point must run as root.'
}

require_commands() {
  local command_name
  for command_name in awk curl date docker flock git grep install mktemp; do
    command -v "$command_name" >/dev/null 2>&1 || fail "Required command is unavailable: ${command_name}"
  done
}

validate_commit() {
  local commit="$1"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail 'Commit must be a lowercase 40-character SHA.'
}

tag_for_commit() {
  printf 'sha-%s\n' "${1:0:7}"
}

host_architecture() {
  case "$(uname -m)" in
    aarch64|arm64) printf 'arm64\n' ;;
    x86_64|amd64) printf 'amd64\n' ;;
    *) fail "Unsupported Docker host architecture: $(uname -m)" ;;
  esac
}

assert_control_lines() {
  [[ -f "$ENV_FILE" ]] || fail "Production environment file is missing: ${ENV_FILE}"

  local key count
  for key in MONEXUS_IMAGE_TAG MONEXUS_PULL_POLICY; do
    count="$(grep -Ec "^${key}=" "$ENV_FILE" || true)"
    [[ "$count" == '1' ]] || fail "${key} must appear exactly once in ${ENV_FILE}."
  done
}

read_env_value() {
  local key="$1"
  awk -v key="$key" '
    index($0, key "=") == 1 {
      value = substr($0, length(key) + 2)
      sub(/\r$/, "", value)
      if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) {
        value = substr(value, 2, length(value) - 2)
      }
      print value
      exit
    }
  ' "$ENV_FILE"
}

write_monitoring_secret() {
  local key="$1"
  local filename="$2"
  local value temporary

  value="$(read_env_value "$key")"
  [[ -n "$value" ]] || fail "${key} is required for production monitoring."
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || \
    fail "${key} must be a single-line value."

  temporary="$(mktemp "${MONITORING_SECRET_DIR}/.${filename}.XXXXXX")"
  printf '%s' "$value" > "$temporary"
  chown root:root "$temporary"
  # The parent directory is root-only. Compose mounts the individual source
  # file read-only so the non-root upstream image can read it in-container.
  chmod 0444 "$temporary"
  mv -f "$temporary" "${MONITORING_SECRET_DIR}/${filename}"
  unset value
}

prepare_monitoring_secrets() {
  install -d -m 0700 -o root -g root "$MONITORING_SECRET_DIR"
  write_monitoring_secret METRICS_TOKEN metrics_token
  write_monitoring_secret SMTP_PASS smtp_password
}

prepare_alertmanager_config() {
  local smtp_host smtp_port smtp_user smtp_from alert_email_to temporary
  smtp_host="$(read_env_value SMTP_HOST)"
  smtp_port="$(read_env_value SMTP_PORT)"
  smtp_port="${smtp_port:-587}"
  smtp_user="$(read_env_value SMTP_USER)"
  smtp_from="$(read_env_value SMTP_FROM)"
  alert_email_to="$(read_env_value ALERT_EMAIL_TO)"

  # check-prod-env.sh has already constrained these interpolated values to
  # conservative single-line scalars. Password material is never rendered.
  [[ "$smtp_host" =~ ^[A-Za-z0-9.-]+$ ]] || fail 'SMTP_HOST is unsafe for Alertmanager configuration.'
  [[ "$smtp_port" =~ ^[0-9]+$ ]] || fail 'SMTP_PORT is unsafe for Alertmanager configuration.'
  [[ "$smtp_user" =~ ^[A-Za-z0-9._@%+:/=-]+$ ]] || fail 'SMTP_USER is unsafe for Alertmanager configuration.'
  [[ "$smtp_from" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || \
    fail 'SMTP_FROM is unsafe for Alertmanager configuration.'
  [[ "$alert_email_to" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || \
    fail 'ALERT_EMAIL_TO is unsafe for Alertmanager configuration.'

  install -d -m 0700 -o root -g root "$MONITORING_CONFIG_DIR"
  temporary="$(mktemp "${MONITORING_CONFIG_DIR}/.alertmanager.yml.XXXXXX")"
  {
    printf '%s\n' \
      'global:' \
      '  resolve_timeout: 5m' \
      "  smtp_smarthost: '${smtp_host}:${smtp_port}'" \
      "  smtp_from: '${smtp_from}'" \
      "  smtp_auth_username: '${smtp_user}'" \
      '  smtp_auth_password_file: /run/secrets/alertmanager_smtp_password' \
      '  smtp_require_tls: true' \
      'route:' \
      '  receiver: value-policy-p1-email' \
      '  group_by: [alertname, routing, severity, environment, service]' \
      '  group_wait: 30s' \
      '  group_interval: 5m' \
      '  repeat_interval: 4h' \
      '  routes:' \
      '    - receiver: monitoring-rehearsal-email' \
      '      group_wait: 1s' \
      '      group_interval: 5s' \
      '      repeat_interval: 1h' \
      '      matchers:' \
      '        - alertname="MoNexusProductionEmailRehearsal"' \
      '    - receiver: value-policy-p0-email' \
      '      matchers:' \
      '        - routing="value-policy-p0"' \
      '    - receiver: value-policy-p1-email' \
      '      matchers:' \
      '        - routing="value-policy-p1"' \
      'receivers:' \
      '  - name: monitoring-rehearsal-email' \
      '    email_configs:' \
      "      - to: '${alert_email_to}'" \
      '        send_resolved: true' \
      '  - name: value-policy-p0-email' \
      '    email_configs:' \
      "      - to: '${alert_email_to}'" \
      '        send_resolved: true' \
      '  - name: value-policy-p1-email' \
      '    email_configs:' \
      "      - to: '${alert_email_to}'" \
      '        send_resolved: true'
  } > "$temporary"
  chown root:root "$temporary"
  chmod 0444 "$temporary"
  mv -f "$temporary" "${MONITORING_CONFIG_DIR}/alertmanager.yml"
}

prepare_monitoring_runtime() {
  prepare_monitoring_secrets
  prepare_alertmanager_config
}

validate_monitoring_runtime() {
  local release_path="$1"

  docker run --rm --network none \
    --volume "${MONITORING_CONFIG_DIR}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro" \
    --volume "${MONITORING_SECRET_DIR}/smtp_password:/run/secrets/alertmanager_smtp_password:ro" \
    --entrypoint /bin/amtool \
    "$ALERTMANAGER_IMAGE" \
    check-config /etc/alertmanager/alertmanager.yml >/dev/null

  docker run --rm --network none \
    --volume "${release_path}/deploy/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro" \
    --volume "${release_path}/docs/operations/value-policy-alerts.rules.yml:/etc/prometheus/rules/value-policy-alerts.rules.yml:ro" \
    --volume "${release_path}/docs/operations/payment-alerts.rules.yml:/etc/prometheus/rules/payment-alerts.rules.yml:ro" \
    --volume "${MONITORING_SECRET_DIR}/metrics_token:/run/secrets/metrics_token:ro" \
    --entrypoint /bin/promtool \
    "$PROMETHEUS_IMAGE" \
    check config /etc/prometheus/prometheus.yml >/dev/null
}

use_vps_proxy_overlay() {
  local count value

  # Existing hosts may publish WEB_PORT directly. Do not silently change that
  # network boundary on their first automated release: the loopback-only
  # overlay is opt-in and is appropriate only after a host proxy is already
  # serving the public HTTPS endpoint.
  count="$(grep -Ec "^${VPS_PROXY_OVERLAY_KEY}=" "$ENV_FILE" || true)"
  [[ "$count" == '0' ]] && return 1
  [[ "$count" == '1' ]] || fail "${VPS_PROXY_OVERLAY_KEY} must appear at most once in ${ENV_FILE}."

  value="$(read_env_value "$VPS_PROXY_OVERLAY_KEY")"
  case "$value" in
    true) return 0 ;;
    false) return 1 ;;
    *) fail "${VPS_PROXY_OVERLAY_KEY} must be true or false when set." ;;
  esac
}

release_path_for_commit() {
  printf '%s/%s\n' "$RELEASE_ROOT" "$1"
}

prepare_release_source() {
  local commit="$1"
  local release_path
  release_path="$(release_path_for_commit "$commit")"

  install -d -m 0755 "$RELEASE_ROOT"

  if [[ -e "$release_path" ]]; then
    [[ -d "$release_path/.git" ]] || fail "Existing release path is not a Git checkout: ${release_path}"
  else
    notice "Cloning immutable release source into ${release_path}"
    GIT_TERMINAL_PROMPT=0 git clone --quiet --no-checkout "$REPOSITORY_URL" "$release_path"
  fi

  [[ "$(git -C "$release_path" remote get-url origin)" == "$REPOSITORY_URL" ]] || \
    fail "Release source origin is not the expected repository: ${release_path}"

  GIT_TERMINAL_PROMPT=0 git -C "$release_path" fetch --quiet origin \
    'refs/heads/master:refs/remotes/origin/master'
  git -C "$release_path" cat-file -e "${commit}^{commit}" || \
    fail "Requested commit is absent from the verified release source."
  git -C "$release_path" merge-base --is-ancestor "$commit" refs/remotes/origin/master || \
    fail 'Requested commit is not reachable from origin/master.'
  git -C "$release_path" checkout --quiet --detach "$commit"

  [[ "$(git -C "$release_path" rev-parse HEAD)" == "$commit" ]] || \
    fail 'Release checkout does not match the requested commit.'
  [[ -z "$(git -C "$release_path" status --porcelain)" ]] || \
    fail 'Release checkout is unexpectedly dirty.'

  printf '%s\n' "$release_path"
}

verify_target_image() {
  local image="$1"
  local commit="$2"
  local expected_architecture="$3"
  local architecture revision

  docker pull --quiet "$image" >/dev/null
  architecture="$(docker image inspect --format '{{.Architecture}}' "$image")"
  revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")"

  [[ "$architecture" == "$expected_architecture" ]] || \
    fail "Image architecture mismatch for ${image}: expected ${expected_architecture}, received ${architecture}."
  [[ "$revision" == "$commit" ]] || \
    fail "Image revision label mismatch for ${image}."
}

record_deployment_state() {
  local commit="$1"
  local tag="$2"
  local release_path="$3"
  local timestamp state_file env_backup

  install -d -m 0700 "$STATE_ROOT"
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  state_file="${STATE_ROOT}/${timestamp}-${tag}.state"
  env_backup="${STATE_ROOT}/${timestamp}-${tag}.env.bak"

  umask 077
  cp -p "$ENV_FILE" "$env_backup"
  chmod 0600 "$env_backup"

  {
    printf 'target_commit=%s\n' "$commit"
    printf 'target_tag=%s\n' "$tag"
    printf 'release_source=%s\n' "$release_path"
    printf 'previous_env_tag=%s\n' "$(read_env_value MONEXUS_IMAGE_TAG)"
    printf 'previous_env_pull_policy=%s\n' "$(read_env_value MONEXUS_PULL_POLICY)"
    printf 'previous_server_image=%s\n' "$(docker inspect --format '{{.Config.Image}}' monexus-server-prod)"
    printf 'previous_web_image=%s\n' "$(docker inspect --format '{{.Config.Image}}' monexus-web-prod)"
    printf 'recorded_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$state_file"
  chmod 0600 "$state_file"

  notice "Recorded protected deployment state: ${state_file##*/}"
}

set_runtime_image_tag() {
  local tag="$1"
  local temporary_env

  temporary_env="$(mktemp "${ENV_FILE}.deploy.XXXXXX")"
  chmod --reference="$ENV_FILE" "$temporary_env"
  chown --reference="$ENV_FILE" "$temporary_env"

  awk -v tag="$tag" '
    /^MONEXUS_IMAGE_TAG=/ {
      print "MONEXUS_IMAGE_TAG=" tag
      next
    }
    /^MONEXUS_PULL_POLICY=/ {
      print "MONEXUS_PULL_POLICY=missing"
      next
    }
    { print }
  ' "$ENV_FILE" > "$temporary_env"

  if ! grep -Fqx "MONEXUS_IMAGE_TAG=${tag}" "$temporary_env"; then
    unlink -- "$temporary_env"
    fail 'Failed to write the requested immutable image tag to the temporary environment file.'
  fi
  if ! grep -Fqx 'MONEXUS_PULL_POLICY=missing' "$temporary_env"; then
    unlink -- "$temporary_env"
    fail 'Failed to write the required pull policy to the temporary environment file.'
  fi
  mv -f "$temporary_env" "$ENV_FILE"
}

wait_for_healthy() {
  local container="$1"
  local deadline state
  deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS))
  state='unknown'

  while (( SECONDS < deadline )); do
    state="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container")"
    if [[ "$state" == 'healthy' ]]; then
      return 0
    fi
    if [[ "$state" == 'exited' || "$state" == 'dead' ]]; then
      fail "${container} entered terminal state ${state}; no automatic rollback was attempted."
    fi
    sleep 3
  done

  fail "Timed out waiting for ${container}; last state was ${state}; no automatic rollback was attempted."
}

assert_loopback_health() {
  local web_port status endpoint
  web_port="$(read_env_value WEB_PORT)"
  web_port="${web_port:-18089}"
  [[ "$web_port" =~ ^[0-9]{1,5}$ ]] || fail 'WEB_PORT must be a numeric TCP port.'
  (( web_port >= 1 && web_port <= 65535 )) || fail 'WEB_PORT is outside the valid TCP port range.'

  for endpoint in / /api/health/live /api/health/ready; do
    status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
      --max-time 15 "http://127.0.0.1:${web_port}${endpoint}")" || \
      fail "Loopback health request failed for ${endpoint}."
    [[ "$status" == '200' ]] || fail "Loopback health request returned ${status} for ${endpoint}."
  done
}

assert_running_target() {
  local container="$1"
  local commit="$2"
  local image revision health

  image="$(docker inspect --format '{{.Config.Image}}' "$container")"
  revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")"
  health="$(docker inspect --format '{{.State.Health.Status}}' "$container")"

  [[ "$revision" == "$commit" ]] || fail "${container} is not running the requested image revision."
  [[ "$health" == 'healthy' ]] || fail "${container} is not healthy after deployment."
}

container_ipv4() {
  local container="$1"
  local address
  address="$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$container")"
  [[ "$address" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || \
    fail "Unable to resolve the private IPv4 address for ${container}."
  printf '%s\n' "$address"
}

monitoring_contract_ready() {
  local prometheus_address="$1"
  local targets rules alert_name

  targets="$(curl --noproxy '*' --fail --silent --show-error --max-time 15 \
    "http://${prometheus_address}:9090/api/v1/targets" 2>/dev/null)" || return 1
  grep -Fq '"job":"monexus"' <<< "$targets" || return 1
  grep -Fq '"health":"up"' <<< "$targets" || return 1

  rules="$(curl --noproxy '*' --fail --silent --show-error --max-time 15 \
    "http://${prometheus_address}:9090/api/v1/rules" 2>/dev/null)" || return 1
  for alert_name in \
    MoNexusValuePolicyUnavailable \
    MoNexusEnabledModeOrderMissingSnapshot \
    MoNexusValuePolicyChangedRateElevated; do
    grep -Fq "\"name\":\"${alert_name}\"" <<< "$rules" || return 1
  done

  return 0
}

assert_monitoring_contract() {
  local prometheus_address deadline
  prometheus_address="$(container_ipv4 monexus-prometheus-prod)"
  deadline=$((SECONDS + MONITORING_READY_TIMEOUT_SECONDS))

  while (( SECONDS < deadline )); do
    if monitoring_contract_ready "$prometheus_address"; then
      return 0
    fi
    sleep 3
  done

  fail "Prometheus scrape target and required ValuePolicy rules did not become ready within ${MONITORING_READY_TIMEOUT_SECONDS} seconds."
}

alertmanager_email_metric() {
  local address="$1"
  local metric_name="$2"
  curl --noproxy '*' --fail --silent --show-error --max-time 15 \
    "http://${address}:9093/metrics" | awk -v metric="$metric_name" '
      index($1, metric "{") == 1 && $1 ~ /integration="email"/ { total += $2 }
      END { printf "%.0f\n", total + 0 }
    '
}

post_rehearsal_alert() {
  local address="$1"
  local routing="$2"
  local starts_at="$3"
  local ends_at="$4"
  local severity
  severity='P1'
  [[ "$routing" == 'value-policy-p0' ]] && severity='P0'

  curl --noproxy '*' --fail --silent --show-error --max-time 15 \
    --header 'Content-Type: application/json' \
    --data-binary @- \
    "http://${address}:9093/api/v2/alerts" >/dev/null <<JSON
[{"labels":{"alertname":"${MONITORING_REHEARSAL_ALERT}","routing":"${routing}","severity":"${severity}","environment":"production","service":"monexus-api"},"annotations":{"summary":"Authorized MoNexus production email rehearsal","description":"Synthetic alert for notification-path validation; not a ValuePolicy incident."},"startsAt":"${starts_at}","endsAt":"${ends_at}"}]
JSON
}

wait_for_email_notification() {
  local address="$1"
  local initial_total="$2"
  local initial_failed="$3"
  local deadline total failed
  deadline=$((SECONDS + 120))

  while (( SECONDS < deadline )); do
    total="$(alertmanager_email_metric "$address" alertmanager_notifications_total)"
    failed="$(alertmanager_email_metric "$address" alertmanager_notifications_failed_total)"
    if (( failed > initial_failed )); then
      fail 'Alertmanager reported a failed email notification during rehearsal.'
    fi
    if (( total > initial_total )); then
      return 0
    fi
    sleep 5
  done

  fail 'Timed out waiting for Alertmanager to report a successful email notification.'
}

run_dry_run() {
  local commit="$1"
  local tag
  tag="$(tag_for_commit "$commit")"
  assert_control_lines
  notice "action=dry-run"
  notice "target_commit=${commit}"
  notice "target_tag=${tag}"
  notice "release_path=$(release_path_for_commit "$commit")"
  notice 'No source checkout, image pull, environment change, migration, or container restart was performed.'
}

run_deploy() {
  local commit="$1"
  local tag release_path expected_architecture
  local -a compose

  tag="$(tag_for_commit "$commit")"
  expected_architecture="$(host_architecture)"
  assert_control_lines

  exec 9>"$LOCK_FILE"
  flock -n 9 || fail 'Another MoNexus Compose deployment is already in progress.'

  release_path="$(prepare_release_source "$commit")"
  # The checker is deliberately invoked with bash, so a normal tracked
  # script only needs to be present; Git does not require its executable bit.
  [[ -f "${release_path}/scripts/check-prod-env.sh" ]] || \
    fail 'Verified release does not contain the production environment checker.'

  bash "${release_path}/scripts/check-prod-env.sh" --mode production --env-file "$ENV_FILE"

  compose=(
    docker compose
    --project-name "$PROJECT_NAME"
    --env-file "$ENV_FILE"
    -f "${release_path}/docker-compose.prod.yml"
  )

  if use_vps_proxy_overlay; then
    [[ -f "${release_path}/docker-compose.vps.yml" ]] || \
      fail 'Verified release does not contain the VPS proxy Compose overlay.'
    compose+=(-f "${release_path}/docker-compose.vps.yml")
    notice 'Using the loopback-only VPS proxy overlay (explicitly enabled).'
  else
    notice 'Using the base Compose port mapping; existing direct WEB_PORT exposure is preserved.'
  fi

  compose+=(--profile selfhost-storage --profile production-monitoring)

  MONEXUS_IMAGE_TAG="$tag" MONEXUS_PULL_POLICY='missing' "${compose[@]}" config --quiet
  verify_target_image "ghcr.io/amo0114/monexus-server:${tag}" "$commit" "$expected_architecture"
  verify_target_image "ghcr.io/amo0114/monexus-web:${tag}" "$commit" "$expected_architecture"
  "${compose[@]}" pull --quiet prometheus alertmanager
  prepare_monitoring_runtime
  validate_monitoring_runtime "$release_path"

  record_deployment_state "$commit" "$tag" "$release_path"
  set_runtime_image_tag "$tag"

  notice 'Recreating server only; Prisma migrations run in the server image entrypoint.'
  "${compose[@]}" up -d --no-deps --force-recreate server
  wait_for_healthy monexus-server-prod

  notice 'Recreating web only after server readiness passed.'
  "${compose[@]}" up -d --no-deps --force-recreate web
  wait_for_healthy monexus-web-prod

  notice 'Recreating private Alertmanager and Prometheus after application readiness passed.'
  "${compose[@]}" up -d --no-deps --force-recreate alertmanager
  wait_for_healthy monexus-alertmanager-prod
  "${compose[@]}" up -d --no-deps --force-recreate prometheus
  wait_for_healthy monexus-prometheus-prod

  assert_loopback_health
  assert_running_target monexus-server-prod "$commit"
  assert_running_target monexus-web-prod "$commit"
  assert_monitoring_contract

  notice "deployment_result=success target_commit=${commit} target_tag=${tag}"
}

run_alert_rehearsal() {
  local routing="$1"
  local address starts_at firing_ends_at resolved_at
  local total_before failed_before total_after_firing failed_after_firing

  exec 9>"$LOCK_FILE"
  flock -n 9 || fail 'Another MoNexus Compose deployment or rehearsal is already in progress.'

  [[ "$(docker inspect --format '{{.State.Health.Status}}' monexus-alertmanager-prod)" == 'healthy' ]] || \
    fail 'Production Alertmanager is not healthy.'
  [[ "$(docker inspect --format '{{.State.Health.Status}}' monexus-prometheus-prod)" == 'healthy' ]] || \
    fail 'Production Prometheus is not healthy.'
  assert_monitoring_contract

  address="$(container_ipv4 monexus-alertmanager-prod)"
  total_before="$(alertmanager_email_metric "$address" alertmanager_notifications_total)"
  failed_before="$(alertmanager_email_metric "$address" alertmanager_notifications_failed_total)"
  starts_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  firing_ends_at="$(date -u -d '+15 minutes' +%Y-%m-%dT%H:%M:%SZ)"

  post_rehearsal_alert "$address" "$routing" "$starts_at" "$firing_ends_at"
  wait_for_email_notification "$address" "$total_before" "$failed_before"

  total_after_firing="$(alertmanager_email_metric "$address" alertmanager_notifications_total)"
  failed_after_firing="$(alertmanager_email_metric "$address" alertmanager_notifications_failed_total)"
  resolved_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  post_rehearsal_alert "$address" "$routing" "$starts_at" "$resolved_at"
  wait_for_email_notification "$address" "$total_after_firing" "$failed_after_firing"

  notice "monitoring_rehearsal=success routing=${routing} firing_email=accepted resolved_email=accepted"
}

main() {
  [[ "$#" -eq 2 ]] || { usage >&2; exit 64; }

  local action="$1"
  local argument="$2"

  require_root
  require_commands

  case "$action" in
    dry-run)
      validate_commit "$argument"
      run_dry_run "$argument"
      ;;
    deploy)
      validate_commit "$argument"
      run_deploy "$argument"
      ;;
    rehearse-alert)
      [[ "$argument" == 'value-policy-p0' || "$argument" == 'value-policy-p1' ]] || \
        fail 'Alert rehearsal routing must be value-policy-p0 or value-policy-p1.'
      run_alert_rehearsal "$argument"
      ;;
    *) usage >&2; exit 64 ;;
  esac
}

main "$@"
