{
  "name": "monexus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:package-versions": "node scripts/check-package-versions.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs --output server/build-info.json --dev",
    "check:nginx": "bash scripts/check-nginx-config.sh",
    "verify:local": "bash scripts/verify-local.sh",
    "verify:local:no-e2e": "RUN_E2E=false bash scripts/verify-local.sh",
    "verify:quick": "bash scripts/verify-quick.sh",
    "verify:m3-identity-security-hardening": "bash scripts/verify-m3-identity-security-hardening.sh",
    "verify:compose-production-deploy": "bash scripts/verify-compose-production-deploy.sh",
    "prod:env": "bash scripts/check-prod-env.sh",
    "prod:env:staging": "bash scripts/check-prod-env.sh --mode staging --env-file .env.staging.local",
    "prod:env:staging-template": "bash scripts/check-prod-env.sh --mode staging --env-file .env.staging.example --allow-placeholders",
    "prod:config": "bash scripts/prod-compose-config.sh",
    "prod:build": "docker compose --project-name ${COMPOSE_PROJECT_NAME:-monexus-prod} --env-file ${ENV_FILE:-.env} -f docker-compose.prod.yml build",
    "prod:up": "docker compose --project-name ${COMPOSE_PROJECT_NAME:-monexus-prod} --env-file ${ENV_FILE:-.env} -f docker-compose.prod.yml up -d",
    "prod:ps": "docker compose --project-name ${COMPOSE_PROJECT_NAME:-monexus-prod} --env-file ${ENV_FILE:-.env} -f docker-compose.prod.yml ps",
    "prod:smoke": "bash scripts/prod-smoke.sh",
    "prod:gate": "npm run prod:env && npm run prod:config && npm run prod:build && npm run prod:up && npm run prod:ps && REQUIRE_METRICS_TOKEN=true npm run prod:smoke",
    "backup:restore-check": "bash scripts/restore-check.sh",
    "backup:restore-objects-check": "bash scripts/restore-objects-check.sh",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc -b && vite build",
    "check:bundle-budget": "npm run build && node scripts/check-frontend-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mobile-island": "vitest run src/stores/islandQueue.test.ts src/hooks/useIslandQueuePause.test.ts src/lib/completionFeedback.test.ts src/lib/productPublicationFeedback.test.ts src/realtime/__tests__/notificationIsland.test.ts src/components/ActionIslandNotice.test.tsx src/components/MobileSearchIsland.test.tsx src/components/StoreSearchPanel.test.tsx src/components/OrderSuccessIsland.test.tsx src/components/QuietIslandNotice.test.tsx src/components/AnnouncementBanner.test.tsx src/components/EmailVerificationBanner.test.tsx src/components/OrderDetailModal.test.tsx src/components/profile/InviteCard.test.tsx src/components/catalog/CategoryApplicationPanel.test.tsx src/components/merchant/MerchantAvailabilityModal.test.tsx src/components/merchandising/MerchantPromotionPage.test.tsx src/components/merchandising/promotionFeedback.test.ts src/pages/MerchantApplyPage.test.tsx src/pages/MerchantDashboardPage.test.tsx src/pages/recharge/islandFeedback.test.ts --maxWorkers=2",
    "e2e:mobile-island": "playwright test --config playwright.mobile-island.config.ts",
    "verify:mobile-island": "npm run test:mobile-island && npm run e2e:mobile-island && npm run build",
    "e2e": "playwright test",
    "e2e:legal": "playwright test --config playwright.legal-pages.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/react": "^10.53.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "altcha": "2.3.0",
    "axios": "^1.7.0",
    "dompurify": "^3.4.1",
    "lucide-react": "^0.460.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^6.28.0",
    "web-vitals": "^5.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
