# Production bootstrap. Copy to .env and replace placeholders on the host.
# This template keeps infrastructure, safety gates, monitoring and recovery.
# Optional feature knobs remain documented in .env.example.
# Ownership and activation: docs/operations/runtime-settings.md
# Validate: npm run prod:env -- --env-file .env

# Database and application identity (generate independent secrets).
POSTGRES_USER=monexus
POSTGRES_PASSWORD=<set-strong-random-password>
POSTGRES_DB=monexus
JWT_SECRET=<set-generated-csprng-value>
MFA_ENCRYPTION_KEY=<set-32-byte-base64-secret>
FRONTEND_ORIGIN=https://app.example.com
COOKIE_SECURE=true
USER_STATUS_CACHE_TTL_SEC=60
# Match your proxy topology; see the VPS/1Panel deployment runbook.
DEPLOY_TOPOLOGY=cloudflare_openresty_nginx
TRUST_PROXY=2
WEB_PORT=18089
MONEXUS_USE_VPS_PROXY_OVERLAY=true

# Public object storage bootstrap and isolated private delivery bucket.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=monexus-uploads
STORAGE_ACCESS_KEY=<set-storage-access-key>
STORAGE_SECRET_KEY=<set-storage-secret-key>
STORAGE_PUBLIC_URL_BASE=https://app.example.com/uploads
DELIVERY_STORAGE_BUCKET=monexus-files
DELIVERY_STORAGE_PUBLIC_ENDPOINT=https://app.example.com
STORAGE_CREDENTIALS_ENC_KEY=<set-64-hex-secret>
WEBHOOK_SECRET_ENC_KEY=<set-independent-64-hex-secret>

# Registration protection (independent 32-byte standard-base64 keys).
ABUSE_PROTECTION_MODE=enforce
ABUSE_HASH_KEY=<set-independent-32-byte-base64-secret>
HUMAN_VERIFICATION_PROVIDER=altcha
ALTCHA_HMAC_KEY=<set-another-independent-32-byte-base64-secret>
REDIS_ENABLED=true
REDIS_REQUIRED=true
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=<set-strong-random-password>
LEGAL_PAGES_ENABLED=true
LEGAL_PAGES_ENFORCEMENT=enforce

# Ops alert delivery also bootstraps business mail before admin activation.
# These remain required for independent Alertmanager alerts after activation.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<set-provider-user>
SMTP_PASS=<set-provider-password-or-token>
SMTP_FROM=noreply@example.com
ALERT_EMAIL_TO=alerts@example.com
METRICS_TOKEN=<set-random-bearer-token>

# Optional external roots for saving secrets from the admin panel.
# Generate each independently with openssl rand -hex 32; retain offsite.
MAIL_CREDENTIALS_ENC_KEY=
INTEGRATION_CREDENTIALS_ENC_KEY=
AI_CREDENTIALS_ENC_KEY=

# Encrypted backups. The restore URL must target an isolated rehearsal DB.
BACKUP_SOURCE=docker-compose
BACKUP_COMPOSE_ENV_FILE=/opt/monexus/.env
BACKUP_COMPOSE_PROJECT_NAME=monexus-prod
BACKUP_OBJECT_MODE=compose-minio
BACKUP_AGE_RECIPIENT=age1<set-offsite-recovery-recipient>
RESTORE_TARGET_URL=postgresql://monexus_restore:<password>@staging-db.example.com:5432/monexus_restore?sslmode=require

# Notifications default off; enable and set retention in admin settings.
# AI and storage providers are managed in their existing admin panels.
# Payments and external fulfillment default disabled; configure separately.
