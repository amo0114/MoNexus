# =============================================================================
# MoNexus — dedicated staging environment variables
#
# Copy this file only onto the isolated staging host as
# `/etc/monexus/staging.env`, restrict it to the deploy user, and replace every
# placeholder there. Never commit a filled environment file or paste values
# into an issue, PR, shell history, or chat.
#
# Validate the private file with:
#   bash scripts/check-prod-env.sh --mode staging --env-file /etc/monexus/staging.env
# =============================================================================

# --- Database: isolated Compose volume/database only ---
POSTGRES_USER=monexus_staging
POSTGRES_PASSWORD=<set-strong-random-password>
POSTGRES_DB=monexus_staging

# --- Server / browser origin ---
JWT_SECRET=<set-generated-csprng-value-at-least-32-chars>
# Canonical standard-base64 encodings of independent 32-byte values. Do not
# reuse either key, JWT_SECRET, or a production value.
MFA_ENCRYPTION_KEY=<set-32-byte-base64-secret>
ABUSE_HASH_KEY=<set-independent-32-byte-base64-secret>
FRONTEND_ORIGIN=https://staging.monexus.oai-o.com
APP_BASE_URL=https://staging.monexus.oai-o.com
COOKIE_SECURE=true
# Public staging is Caddy -> bundled Nginx -> Express (two trusted hops).
DEPLOY_TOPOLOGY=caddy
TRUST_PROXY=2
USER_STATUS_CACHE_TTL_SEC=60
API_RATE_LIMIT_MAX=300

# --- Notification realtime rehearsal defaults ---
# The checked-in template remains safely disabled. The protected staging
# rehearsal temporarily enables both flags and restores this private file.
NOTIFICATION_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EXPIRY_DAYS=90
NOTIFICATION_REALTIME_ENABLED=false
NOTIFICATION_REALTIME_HEARTBEAT_MS=20000
NOTIFICATION_REALTIME_MAX_CONNECTIONS_PER_USER=5
NOTIFICATION_REALTIME_MAX_CONNECTIONS_PER_IP=20
NOTIFICATION_REALTIME_MAX_CONNECTIONS=1000
NOTIFICATION_REALTIME_MAX_BUFFER_BYTES=65536
NOTIFICATION_REALTIME_CONNECT_RATE_LIMIT_MAX=30
NOTIFICATION_REALTIME_SHUTDOWN_GRACE_MS=5000

# --- Legal pages & consent: staging mirrors production enforcement ---
LEGAL_PAGES_ENABLED=true
LEGAL_PAGES_ENFORCEMENT=enforce

# SPEC-VALUE-POLICY-P1-001: Node runtime stays production-grade. Preflight
# rejects an explicit MONEXUS_DEPLOY_ENV=production in --mode staging; the
# staging Compose overlay also hardcodes staging so this file cannot
# re-label the stack. Do not seed an active production ratio.
MONEXUS_DEPLOY_ENV=staging
POINT_VALUE_POLICY_MODE=off

# --- Registration abuse protection: always fail closed in staging ---
ABUSE_PROTECTION_MODE=enforce
HUMAN_VERIFICATION_PROVIDER=altcha
ALTCHA_HMAC_KEY=<set-32-byte-base64-secret>
ALTCHA_MAX_NUMBER=100000
ALTCHA_CHALLENGE_TTL_SEC=120
ALTCHA_SOLVE_TIMEOUT_MS=20000
# Optional Turnstile adapter. Required only when HUMAN_VERIFICATION_PROVIDER=turnstile.
# TURNSTILE_SITE_KEY=<set-staging-turnstile-site-key>
# TURNSTILE_SECRET_KEY=<set-staging-turnstile-secret-key>
# TURNSTILE_ALLOWED_HOSTNAMES=staging.monexus.oai-o.com

# --- Redis: bundled, password-protected, and isolated from production ---
REDIS_ENABLED=true
REDIS_REQUIRED=true
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=<set-strong-staging-redis-password>
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=100
REDIS_COMMAND_TIMEOUT_MS=80
REDIS_CIRCUIT_ERROR_THRESHOLD=5
REDIS_CIRCUIT_OPEN_MS=30000
CACHE_KEY_PREFIX=monexus:staging
CACHE_PRODUCT_LIST=true
CACHE_PRODUCT_DETAIL=true
CACHE_PRODUCT_REVIEWS=true
CACHE_PRODUCT_LIST_VERSION_COALESCE_MS=10000
CACHE_MAX_VALUE_BYTES=524288

# --- Object storage: bundled, isolated MinIO ---
# The staging Compose launcher enables the selfhost-storage profile.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=monexus-staging-uploads
STORAGE_ACCESS_KEY=<set-staging-minio-user>
STORAGE_SECRET_KEY=<set-staging-minio-password>
STORAGE_PUBLIC_URL_BASE=https://staging.monexus.oai-o.com/uploads
STORAGE_FORCE_PATH_STYLE=true
DELIVERY_STORAGE_BUCKET=monexus-staging-files
DELIVERY_STORAGE_PUBLIC_ENDPOINT=https://staging.monexus.oai-o.com

# --- Transactional email: internal Mailpit catcher, never a real sender ---
# The staging launcher enables `staging-mail`. Mailpit's web UI stays bound to
# 127.0.0.1; inspect it through an SSH tunnel rather than a public port.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@staging.monexus.oai-o.com

# --- Observability ---
SENTRY_DSN=https://<set-staging-key>@<set-staging-sentry-host>/<project>
VITE_SENTRY_DSN=https://<set-staging-key>@<set-staging-sentry-host>/<project>
LOG_LEVEL=info
METRICS_TOKEN=<set-random-staging-bearer-token-at-least-32-chars>

# --- Persistent merchant webhook encryption ---
# Required by the runtime container even before a merchant configures a
# webhook. Generate with `openssl rand -hex 32` in the approved secret session.
WEBHOOK_SECRET_ENC_KEY=<set-64-hex-secret>
AUTO_PROVISION_ALLOW_INSECURE_TARGETS=false

# --- Backup / restore rehearsal ---
BACKUP_SOURCE=docker-compose
BACKUP_COMPOSE_ENV_FILE=/etc/monexus/staging.env
BACKUP_COMPOSE_PROJECT_NAME=monexus-staging
BACKUP_AGE_RECIPIENT=age1<set-offsite-recovery-recipient>
BACKUP_OBJECT_MODE=compose-minio
# This is deliberately a non-production target because restore checks drop and
# recreate its schema. It may be a separate disposable database on the staging host.
RESTORE_TARGET_URL=postgresql://monexus_restore:<password>@staging-db.example.com:5432/monexus_restore?sslmode=require

# --- Host ports and local-only image tags ---
# docker-compose.vps.yml binds WEB_PORT to 127.0.0.1; host Caddy owns :80/:443.
WEB_PORT=18081
MAILPIT_WEB_PORT=18082
MONEXUS_IMAGE_TAG=staging
MONEXUS_PULL_POLICY=never
