generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  role               String    @default("user") // user | admin | merchant
  status             String    @default("正常")
  nickname           String? // 1-20 字;注册可选,空则系统生成 mn_XXXXXXXX
  avatarUrl          String? // 公开图床 URL(POST /uploads/image → OSS/public)
  emailVerified      DateTime?
  // Stops this user from qualifying new invite relations. It never rewrites
  // already granted PointLog history.
  referralSuspended  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  // MFA seed is AES-256-GCM ciphertext. It must never be selected by public
  // serializers; only the auth MFA service reads it explicitly.
  mfaEnabled         Boolean   @default(false)
  mfaSecretEncrypted String?
  mfaVerifiedAt      DateTime?
  mfaVersion         Int       @default(0)

  pointAccount                 PointAccount?
  orders                       Order[]
  pointLogs                    PointLog[]
  checkins                     CheckinRecord[]
  refreshTokens                RefreshToken[]
  orderStatusEvents            OrderStatusEvent[]
  invitedBy                    InviteRelation[]              @relation("invitee")
  invites                      InviteRelation[]              @relation("inviter")
  growthRewards                GrowthReward[]                @relation("GrowthRewardRecipient")
  abuseEvents                  AbuseEvent[]                  @relation("AbuseEventUser")
  abuseEventsAsInviter         AbuseEvent[]                  @relation("AbuseEventInviter")
  abuseEventsAsInvitee         AbuseEvent[]                  @relation("AbuseEventInvitee")
  adminLogs                    AdminLog[]
  updatedSystemConfigs         SystemConfig[]                @relation("SystemConfigUpdatedBy")
  approvedMerchants            Merchant[]                    @relation("MerchantApprovedBy")
  merchant                     Merchant?
  passwordResetTokens          PasswordResetToken[]
  emailVerificationTokens      EmailVerificationToken[]
  reviews                      Review[]
  announcementsCreated         Announcement[]                @relation("AnnouncementCreatedBy")
  announcementReceipts         AnnouncementReceipt[]
  idempotencyRecords           IdempotencyRecord[]
  fileGrants                   FileGrantLog[]
  mfaRecoveryCodes             MfaRecoveryCode[]
  authChallenges               AuthChallenge[]
  securityEvents               SecurityEvent[]
  fakaProvisionEmailProofs     FakaProvisionEmailProof[]
  fakaProvisionEmailSendBudget FakaProvisionEmailSendBudget?
  leaderboardEntries           LeaderboardEntry[]
  inviteCodesIssued            InviteCode[]                  @relation("InviteCodeIssuer")
  inviteCodeUsed               InviteCode?                   @relation("InviteCodeUsedBy")
  userAgreementConsents        UserAgreementConsent[]
  orderAgreementAcceptances    OrderAgreementAcceptance[]
  notifications                Notification[]

  // SPEC-VALUE-POLICY-ACTIVATION-CONTROLS-001: immutable governance actors.
  valuePoliciesCreated   ValuePolicy[]                  @relation("ValuePolicyCreatedBy")
  valuePoliciesApproved  ValuePolicy[]                  @relation("ValuePolicyApprovedBy")
  valuePoliciesScheduled ValuePolicy[]                  @relation("ValuePolicyScheduledBy")
  valuePoliciesActivated ValuePolicy[]                  @relation("ValuePolicyActivatedBy")
  valuePoliciesRetired   ValuePolicy[]                  @relation("ValuePolicyRetiredBy")
  valuePolicyCommands    ValuePolicyGovernanceCommand[]
  valuePolicyEvents      ValuePolicyGovernanceEvent[]

  // ── FND-CMI-001 Catalog foundation back-relations ──
  categoriesCreated            ProductCategory[]     @relation("CategoryCreatedBy")
  categoriesUpdated            ProductCategory[]     @relation("CategoryUpdatedBy")
  categoryApplicationsReviewed CategoryApplication[]
  importedCatalogLinks         ExternalCatalogLink[]
  productsArchived             Product[]             @relation("ProductArchivedBy")

  // ── FND-CMI-001 Merchandising foundation back-relations ──
  promotionPackagesCreated PromotionPackage[]    @relation("PromotionPackageCreatedBy")
  promotionPackagesUpdated PromotionPackage[]    @relation("PromotionPackageUpdatedBy")
  campaignsReviewed        PromotionCampaign[]   @relation("CampaignReviewedBy")
  campaignsCancelled       PromotionCampaign[]   @relation("CampaignCancelledBy")
  campaignsAdjusted        PromotionCampaign[]   @relation("CampaignAdjustmentBy")
  editorialFeaturesCreated EditorialFeature[]    @relation("EditorialCreatedBy")
  editorialFeaturesRevoked EditorialFeature[]    @relation("EditorialRevokedBy")
  entitlementsGranted      MerchantEntitlement[] @relation("EntitlementGrantedBy")
  entitlementsRevoked      MerchantEntitlement[] @relation("EntitlementRevokedBy")

  // SPEC-RECHARGE-PAYMENT-V1.2
  rechargeQuotes                   RechargeQuote[]
  rechargeOrders                   RechargeOrder[]
  rechargeCredits                  RechargeCredit[]
  rechargeRefundsCreated           RechargeRefund[]            @relation("RechargeRefundCreatedBy")
  pointHolds                       PointHold[]
  rechargeReversals                RechargeReversal[]
  paymentRecoveryCases             PaymentRecoveryCase[]
  paymentRecoveryCasesResolved     PaymentRecoveryCase[]       @relation("PaymentRecoveryCaseResolvedBy")
  accountRestrictions              AccountRestriction[]
  accountRestrictionsReleased      AccountRestriction[]        @relation("AccountRestrictionReleasedBy")
  reconciliationRunsCreated        ReconciliationRun[]         @relation("ReconciliationRunCreatedBy")
  reconciliationItemsResolved      ReconciliationItem[]        @relation("ReconciliationItemResolvedBy")
  rechargeLimitBuckets             RechargeLimitBucket[]
  rechargeIdempotencyRecords       RechargeIdempotencyRecord[]
}

// SPEC-NOTIFY-001 Phase 1：1:1 事务消息（与 Announcement 运营广播分离）。
// 幂等：@@unique([recipientUserId, eventType, dedupeKey])。
// payload 禁止卡密/交付 content/secret；title/body 仅纯文本。
model Notification {
  id                Int       @id @default(autoincrement())
  recipientUserId   Int
  recipientRole     String // user | merchant | admin
  eventType         String // order.created_merchant | order.delivered_buyer ...
  category          String // order | provision | booking | inventory | system
  title             String // 纯文本展示标题（≤100 字）
  body              String // 纯文本短文案（≤500 字；无 HTML/Markdown/图片）
  payload           Json? // { orderId, productName, deliveryMode, ... } 禁止敏感 content
  deeplink          String // 前端路由：/orders?focus=12 | /merchant/orders/12
  level             String    @default("info") // info | success | warning | critical
  status            String    @default("unread") // unread | read | archived
  dedupeKey         String // 幂等键：order:{orderId}:merchant_new
  relatedOrderId    Int?
  relatedMerchantId Int?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?

  user User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([recipientUserId, eventType, dedupeKey])
  @@index([recipientUserId, status, createdAt])
  @@index([relatedOrderId])
  @@index([expiresAt])
}

// SPEC-INVITE-001：一次性邀请码。资格前置到发码侧（IV-04），名额按上海自然月
// 在生成时消耗（IV-05/IV-06）；注册事务内条件更新原子领用，严格一次性（IV-03）。
// `expired` 为惰性判定：读侧一律以 expiresAt 为准（IV-02），无定时任务改状态。
model InviteCode {
  id           Int       @id @default(autoincrement())
  code         String    @unique // ^[A-Z0-9]{8}$，生成字母表见 lib/inviteCode.ts（IV-01）
  issuerId     Int
  status       String    @default("active") // active | used | expired | revoked（expired 惰性，见 IV-02）
  expiresAt    DateTime
  usedByUserId Int?      @unique
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  issuer User  @relation("InviteCodeIssuer", fields: [issuerId], references: [id])
  usedBy User? @relation("InviteCodeUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([issuerId, createdAt]) // 月度名额计数
  @@index([issuerId, status]) // 个人中心列表
}

// FakaBridge 开通邮箱归属证明：防止填写他人 Xboard 邮箱后降配/续费他人套餐。
// OTP 验证成功后与 MoNexus 账号永久绑定（verifiedAt 有值且 proofExpiresAt=null）；
// 之后下单免再验证。proofExpiresAt 非空仅兼容旧 24h 窗口数据。
// 不限制套餐升/降级方向。
model FakaProvisionEmailProof {
  id              Int       @id @default(autoincrement())
  userId          Int
  email           String // 规范化小写
  codeHash        String?
  codeExpiresAt   DateTime?
  sendCount       Int       @default(0)
  lastSentAt      DateTime?
  confirmAttempts Int       @default(0)
  verifiedAt      DateTime?
  // null + verifiedAt = 永久绑定；非 null = 遗留限时证明
  proofExpiresAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, proofExpiresAt])
}

// Per-account outbound OTP budget across every target email.  A single proof
// row cannot represent this safely because repeated sends to one address only
// update that row; this dedicated row serializes all userId mail reservations.
model FakaProvisionEmailSendBudget {
  userId          Int      @id
  windowStartedAt DateTime
  sendCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id             Int       @id @default(autoincrement())
  title          String
  content        String
  audience       String    @default("all") // all | user | merchant | admin
  priority       Int       @default(0) // 数字越大越靠前
  presentation   String    @default("notice") // notice | important | acknowledgement_required
  maxImpressions Int       @default(3) // 仅 notice 使用，单设备展示 1-3 次
  version        Int       @default(1) // 实质内容变更后递增，重新要求阅读/确认
  startsAt       DateTime
  endsAt         DateTime? // null 表示长期
  status         String    @default("draft") // draft | published | archived
  createdBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdByUser User?                 @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id])
  receipts      AnnouncementReceipt[]

  @@index([status, startsAt, endsAt])
  @@index([audience, status])
}

// 已读 / 已确认状态与公告版本绑定。运营修改实质内容后 version 递增，
// 用户会自然获得一条新的待读回执，旧版本记录仍保留作审计依据。
model AnnouncementReceipt {
  id             Int       @id @default(autoincrement())
  announcementId Int
  userId         Int
  version        Int
  readAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, version])
  @@index([userId, readAt])
  @@index([userId, acknowledgedAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Merchant {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  name           String
  description    String?
  status         String    @default("pending") // pending | active | suspended | rejected
  commissionRate Decimal   @default(0.10) @db.Decimal(5, 4)
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  approvedAt     DateTime?
  approvedBy     Int?

  user           User                    @relation(fields: [userId], references: [id])
  approvedByUser User?                   @relation("MerchantApprovedBy", fields: [approvedBy], references: [id])
  products       Product[]
  orders         Order[]
  settlements    Settlement[]
  deliveryFiles  DeliveryFile[]
  webhookConfigs MerchantWebhookConfig[]

  // ── FND-CMI-001 back-relations ──
  categoryApplications CategoryApplication[]
  promotionCampaigns   PromotionCampaign[]
  entitlements         MerchantEntitlement[]
}

// P7b：商家自动开通 webhook 配置（版本化）。轮换/撤销 = 旧行置 revoked +
// （轮换时）新建 active 行；每商家至多一条 active（部分唯一索引
// MerchantWebhookConfig_one_active_per_merchant，仅存在于迁移——Prisma
// 无法表达 WHERE 部分索引，漂移豁免惯例同 Offer.isDefault）。
// ProvisionTask 冻结引用创建时的配置行：任务绝不解析到新配置；引用行
// revoked 后未发出任务安全默认降级人工（硬验收 ⑤）。
// secretCiphertext = AES-256-GCM 密文（lib/webhookSecret.ts），明文仅在
// 创建/再生响应一次性返回，常规序列化只回尾 4 位。
model MerchantWebhookConfig {
  id               Int       @id @default(autoincrement())
  merchantId       Int
  url              String
  secretCiphertext String
  status           String    @default("active") // active | revoked; PostgreSQL CHECK constrained
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  merchant Merchant        @relation(fields: [merchantId], references: [id])
  tasks    ProvisionTask[]

  @@index([merchantId, status])
}

// P7b：自动开通任务（transactional outbox）——下单事务内随订单创建，行存在
// 即下单时刻的意图。协议 = 至少一次外呼（接收端以 taskId 幂等去重）：
// - 认领（provision cron）：FOR UPDATE SKIP LOCKED + 排除未过期 leaseUntil；
//   认领即 attempts+1 并预写退避 nextAttemptAt（崩溃自然落入重试）；
// - 结果落库：id + leaseToken + status='pending' 三条件 CAS——过期 worker
//   的迟到结果被丢弃（硬验收 ⑨）；
// - lastError 只存脱敏诊断码（timeout / dns_blocked / http_503 …），绝不存
//   远端响应体；merchantNotifiedAt 单列管降级邮件（发送成功才落，可重试）。
model ProvisionTask {
  id                 Int       @id @default(autoincrement())
  orderId            Int       @unique
  webhookConfigId    Int
  status             String    @default("pending") // pending | succeeded | degraded | cancelled; CHECK constrained
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now())
  leaseToken         String?
  leaseUntil         DateTime?
  lastError          String?
  lastHttpStatus     Int?
  merchantNotifiedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id])
  webhookConfig MerchantWebhookConfig @relation(fields: [webhookConfigId], references: [id])

  @@index([status, nextAttemptAt])
}

model RefreshToken {
  id               Int       @id @default(autoincrement())
  userId           Int
  tokenHash        String    @unique
  revoked          Boolean   @default(false)
  revokedAt        DateTime?
  revokeReason     String?
  expiresAt        DateTime
  userAgent        String?
  ip               String?
  // PostgreSQL default (rather than Prisma's client-side uuid()) is required
  // to assign a distinct family ID to refresh-token rows that predate M3.
  sessionId        String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionStartedAt DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, sessionId])
  @@index([userId, revoked, expiresAt])
}

model MfaRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model AuthChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  userId          Int
  purpose         String
  secretEncrypted String?
  expiresAt       DateTime
  consumedAt      DateTime?
  failedAttempts  Int       @default(0)
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model SecurityEvent {
  id         Int      @id @default(autoincrement())
  userId     Int?
  sessionId  String?  @db.Uuid
  type       String
  ipHash     String?
  deviceHint String?
  detailSafe Json?
  createdAt  DateTime @default(now())

  // Security evidence survives a future User deletion. sessionId is a
  // family identifier rather than an FK to a single rotated token row.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([type, createdAt])
}

model IdempotencyRecord {
  id            Int      @id @default(autoincrement())
  userId        Int
  key           String   @db.Uuid
  status        String   @default("processing") // processing | completed
  // 持有者租约令牌：每次 claim / 孤儿接管都换新值。complete 与 release
  // 必须同时匹配 token，防止被接管的旧持有者完成订单或删除新持有者的占用。
  claimToken    String   @db.Uuid
  // 请求指纹：productId + expectedPrice + 表单版本 + 规范化答案的 HMAC 摘要。
  // 同一 key 携带不同请求体（含不同答案）必须 409，绝不静默重放另一份提交。
  // 存摘要而非明文，避免低熵答案通过本表泄露。
  productId     Int
  requestDigest String   @default("")
  // 指向该结算意图最终产生的唯一订单；processing 阶段为 null。
  orderId       Int?     @unique
  createdAt     DateTime @default(now())
  // processing 记录超过 expiresAt 视为孤儿（进程崩溃残留），可被同 key 重试接管；
  // completed 记录永久保留重放语义，仅由 cron 按保留期清理。
  expiresAt     DateTime

  user User @relation(fields: [userId], references: [id])

  // 同一用户的同一结算意图只允许一条记录；数据库唯一约束是并发兜底，
  // 应用层的冲突处理只负责区分"重放已完成订单"与"仍在处理中"。
  @@unique([userId, key])
  @@index([expiresAt])
}

model PointAccount {
  id            Int @id @default(autoincrement())
  userId        Int @unique
  balance       Int @default(0) // 可用积分，不包含已冻结的人工服务订单金额
  frozenBalance Int @default(0) // 已为尚未终态的人工服务订单保留的积分
  sandboxBalance Int @default(0) // 管理员沙箱积分；不可用于真实消费/结算

  user User @relation(fields: [userId], references: [id])
}

model PointLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  type         String // in | out | hold | release | refund；会员成长仅统计 in
  amount       Int
  balanceAfter Int
  reason       String?
  orderId      Int?
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  // ── FND-CMI-001 (SPEC-MERCH-001 §5.4): charge/refund named back-relations. ──
  // PromotionCampaign.chargePointLogId / refundPointLogId (both UNIQUE, RESTRICT)
  // point at exactly one PointLog row each; the campaign side owns the FK.
  campaignCharged  PromotionCampaign? @relation("PromotionCampaignCharge")
  campaignRefunded PromotionCampaign? @relation("PromotionCampaignRefund")

  rechargeCredit   RechargeCredit?
  rechargeReversal RechargeReversal?

  // 排行榜按 (type='in', createdAt ∈ 窗口) 聚合；此前本表除主键零索引，
  // 缺了它每次刷新都是全表扫。
  @@index([type, createdAt])
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  richDescription  String?
  type             String // 网络节点 / 共享账号 / 充值卡密 / 邀请码
  icon             String   @default("package")
  imageUrl         String?
  images           String[] @default([])
  // PostgreSQL CHECK constraints (20260724120000) keep commercial values valid
  // even when data is changed outside the API.
  price            Int // > 0
  originalPrice    Int? // null or >= price
  stock            Int      @default(0) // >= 0; instant_inventory availability comes from InventoryItem
  sales            Int      @default(0) // >= 0; 历史成功下单/交付计数，退款不回退，不能用作净成交额
  ratingAvg        Decimal  @default(0) @db.Decimal(2, 1) // ratingCount=0 时无意义，前端显示「暂无评分」
  ratingCount      Int      @default(0)
  // DEPRECATED (SPEC-MERCH-001 D-MERCH-01): legacy column retained only as a
  // no-op. No write path may set it and no public ranking/display may read it.
  isHot            Boolean  @default(false)
  status           String   @default("draft") // draft | active | inactive; PostgreSQL CHECK constrained
  deliveryMode     String   @default("instant_inventory") // instant_inventory | instant_fixed | manual_service; PostgreSQL CHECK constrained
  stockMode        String   @default("limited") // limited | unlimited（instant_inventory 强制 limited）；PostgreSQL CHECK constrained
  fixedContent     String? // instant_fixed 专用：固定交付内容（付费内容，禁止公开序列化）
  fixedContentType String   @default("text") // text | url; PostgreSQL CHECK constrained
  // 购买前信息收集的字段定义（数组，见 orders/purchaseForm.ts 的 zod 契约）。
  // 定义本身是公开的——买家必须看到才能填写；买家的答案存 Order 侧，属敏感数据。
  purchaseForm     Json?
  merchantId       Int?
  createdAt        DateTime @default(now())

  // FND-CMI-001 (SPEC-CATALOG-OPS-001 §5.3): platform-governed taxonomy FK.
  // Final required in F0: nullable -> backfill (20260809020000) -> zero-null
  // guard -> NOT NULL. New writes must provide categoryId (D-CAT-09).
  categoryId  Int
  // First publish time (SPEC-CATALOG-OPS-001 D-CAT-04). Backfilled for legacy
  // active/inactive rows; null for draft/never-published.
  publishedAt DateTime?
  // Admin lifecycle, independent of publish status. Null = not archived.
  archivedAt         DateTime?
  archivedByUserId   Int?
  archiveReason      String?

  merchant      Merchant?       @relation(fields: [merchantId], references: [id])
  reviews       Review[]
  orders        Order[]
  inventory     InventoryItem[]
  inventoryLogs InventoryLog[]
  offers        Offer[]

  category               ProductCategory                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  archivedByUser         User?                          @relation("ProductArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  externalCatalogLink    ExternalCatalogLink?
  catalogSyncIdempotency ExternalCatalogSyncIdempotency[]
  merchandisingSnapshots ProductMerchandisingSnapshot[]
  promotionCampaigns     PromotionCampaign[]
  editorialFeatures      EditorialFeature[]

  @@index([status, isHot, sales, id])
  @@index([categoryId])
  @@index([archivedAt])
}

// SKU/套餐（P4a）：价格、库存与履约配置的真相源（spec §2：Fulfillment 绑定
// SKU 而非商品）。每个商品至少有一条回填的默认 Offer；Product 上的
// price/stock/deliveryMode 等列降级为投影，由服务层在 Offer 写路径同步。
model Offer {
  id                  Int      @id @default(autoincrement())
  productId           Int
  name                String // 月卡 / 季卡 / 美区 …；回填默认 Offer 为「默认规格」
  // CHECK constraints (20260725200000) mirror the Product commercial rules.
  price               Int // > 0
  originalPrice       Int? // null or >= price
  status              String   @default("active") // active | inactive
  deliveryMode        String   @default("instant_inventory") // instant_inventory | instant_fixed | manual_service
  stockMode           String   @default("limited") // limited | unlimited（instant_inventory 强制 limited）
  stock               Int      @default(0) // >= 0
  fixedContent        String? // instant_fixed 专用（text/url 形态）；禁止公开序列化
  fixedContentType    String   @default("text") // text | url | file
  // P5：fixedContentType='file' 时的"当前在售文件"。CHECK（20260726180000）：
  // file 形态要求 instant_fixed + fixedFileId 非空 + fixedContent 为空；
  // 非 file 形态禁止 fixedFileId。只影响新订单——下单事务把它冻结进
  // DeliveryRecord.fileId，旧订单下载永远读快照，绝不回查这里。
  fixedFileId         Int?
  // P4b：交付字段模板 [{ key, label, sensitive, placeholder? }]。null/空 = 纯文本
  // 交付（存量形态，行为不变）。模板本身公开（买家购前可见将获得哪些字段）；
  // 字段"值"的访问边界同 DeliveryRecord.content。instant_fixed 不支持模板。
  deliveryFields      Json?
  sales               Int      @default(0)
  sortOrder           Int      @default(0)
  // 默认规格：只服务兼容路径（商品级编辑、未指定 offerId 的库存操作）。
  // 展示顺序由 sortOrder，列表价取最低 active 价——三个概念显式分离。
  // 每商品至多一条：部分唯一索引 Offer_one_default_per_product（仅存在于
  // 迁移 20260726150000，Prisma schema 无法表达 WHERE 部分索引）。
  // 漂移已探测排除（2026-07-26，全新库 migrate dev 生成空迁移 + migrate diff
  // 空脚本 + 二次 dev "Already in sync"）：带 WHERE 的部分索引对 Prisma diff
  // 引擎不可见，既不会被 DROP 也不会触发 reset；迁移重放保证各环境拥有它。
  // 注意：本仓库只用 migrate 工作流；`prisma db push` 不重放迁移，会得到
  // 没有该索引的库，勿在本项目使用 db push。
  isDefault           Boolean  @default(false)
  // P6a：订阅有效期天数。null = 永久（存量语义）。下单快照进
  // Order.validityDaysSnapshot——商家改时长不影响已购订单；进入
  // checkoutVersion canonical（null 不进，存量摘要不变）。
  validityDays        Int?
  // P7b：自动开通——manual_service 的自动化首次交付（不是第四种交付模式）。
  // CHECK（迁移 20260728100000）：仅 manual_service 且无交付模板可为 true；
  // 服务端校验为主，数据库兜底。进入 checkoutVersion canonical（true 才进）。
  autoProvision       Boolean  @default(false)
  // FakaBridge（Xboard 订阅开通）：null = 无外部集成。
  // externalIntegration='faka_bridge' 时 externalSku 必填（PG CHECK + 服务端）。
  // 与 autoProvision 互斥（迁移 CHECK + 服务端拒绝冲突组合）。
  externalIntegration String? // null | faka_bridge
  externalSku         String? // e.g. aster-basic-monthly — Xboard plugin SKU_MAPPING
  createdAt           DateTime @default(now())

  product        Product         @relation(fields: [productId], references: [id])
  inventory      InventoryItem[]
  orders         Order[]
  lowStockNotice LowStockNotice?
  // Restrict：被在售规格引用的文件行不可删（生命周期只走 status 标记）。
  fixedFile      DeliveryFile?   @relation("OfferFixedFile", fields: [fixedFileId], references: [id], onDelete: Restrict)

  // FND-CMI-001 (D-CAT-19): external identity is unique at the DB level. NULL
  // externalIntegration/SKU rows (ordinary offers) are unconstrained by this.
  @@unique([externalIntegration, externalSku])
  @@index([productId, status, sortOrder])
}

model InventoryLog {
  id          Int      @id @default(autoincrement())
  productId   Int
  // 审计维度补充（P4a）：变更发生在哪个 SKU。可空兼容迁移前行；无外键关系，
  // 审计行不因 Offer 生命周期变化而受约束牵连。
  offerId     Int?
  merchantId  Int?
  actorUserId Int
  action      String // import | void | sale | capacity_adjust | refund_void | refund_restock
  delta       Int // import > 0; void/sale < 0; capacity_adjust != 0; refund_void = 0; refund_restock = +1
  reason      String?
  // sale/refund_void/refund_restock link to an order；P5.5 起同一订单可并存
  // sale 与退款流水两行，orderId 从唯一降级为普通索引。Import operations
  // receive one UUID batch identifier so that a replenishment can be audited
  // without ever placing delivery content in an API response.
  orderId     Int?
  batchId     String?  @unique @db.Uuid
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  // onDelete: Restrict 与 20260724123000 手写迁移保持一致：库存审计行
  // 禁止随订单删除而悄悄断链（Prisma 对可空关系默认 SetNull，会被当作漂移改掉）。
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  // 与 batchId 唯一索引并存的普通索引，同样来自 20260724123000 手写迁移。
  @@index([batchId])
  @@index([orderId])
}

// P5.5：SKU 级低库存告警状态（去重/冷却）。纯运营状态，随 Offer 级联删除。
// 评审修订：PG 的含空列唯一约束无法限制多行 NULL——一律按非空 offerId 去重，
// 所有有限库存规格（即时库存数 available 项；limited 容量看 Offer.stock）
// 都以 Offer 为告警粒度。
model LowStockNotice {
  id             Int       @id @default(autoincrement())
  offerId        Int       @unique
  isLow          Boolean   @default(false)
  lastAvailable  Int
  // 邮件发送成功后才更新；发送失败保持原值，下轮 cron 重试。
  lastNotifiedAt DateTime?
  updatedAt      DateTime  @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

// P6a：订阅到期提醒去重状态（沿 LowStockNotice 语义：发送成功才落 stage，
// 失败保持原值下轮重试）。纯运营状态，随订单不可删（订单本就 Restrict 保护）。
model SubscriptionReminder {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique
  lastStage  String // pre | expired
  lastSentAt DateTime
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// P6c：预约日前提醒去重（双方各一封，同一行标记；发送成功才落行）。
model BookingReminder {
  id      Int      @id @default(autoincrement())
  orderId Int      @unique
  sentAt  DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// P6b：人工履约 SLA 超时提醒去重（每单最多一封邮件；设计决策 ③——超时
// 仅升级提醒，不自动退款/降级，买家侧本就可争议）。
model SlaReminder {
  id      Int      @id @default(autoincrement())
  orderId Int      @unique
  sentAt  DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// P7a：cron 舰队租约——多实例部署下同名 job 的运行互斥（lockedUntil：
// 固定 90s TTL + 心跳续租，批次结束即释放）与窗口节流（lastStartedAt：
// 距上次启动不足「周期 − margin」的领取被拒，窗口严格短于调度周期——
// PR #52 复审 P1）。时间判定全部用 DB now()，不信任实例时钟；实例崩溃
// 后互斥 ≤ 90s 自然过期。见 lib/cronLease.ts。
model CronLease {
  name          String   @id
  holder        String
  leaseToken    String
  lockedUntil   DateTime
  lastStartedAt DateTime
  updatedAt     DateTime @updatedAt
}

model Review {
  id            Int       @id @default(autoincrement())
  productId     Int
  userId        Int
  orderId       Int       @unique // 一订单一评的数据库级保证
  rating        Int // 1-5 整数星
  comment       String? // ≤500 字纯文本
  status        String    @default("visible") // visible | removed
  editableUntil DateTime // 创建时快照 createdAt + 7 天
  editedAt      DateTime? // 非空 = 已用掉唯一一次修改机会
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@index([productId, status, createdAt])
}

model InventoryItem {
  id                Int       @id @default(autoincrement())
  productId         Int
  // 库存归属的 SKU；回填后由迁移 20260725202000 收紧为 NOT NULL。
  // 唯一约束保持商品级（同一商品下卡密不允许重复，与 SKU 无关）。
  offerId           Int
  content           String
  // P4b：结构化交付内容 { fields, values }（自包含模板快照，商家改模板不影响
  // 已导入条目）。content 保持权威——由结构化值生成规范化文本，唯一约束、
  // 领取 SQL、审计路径零改动；structuredContent 仅是展示层增强。
  structuredContent Json?
  status            String    @default("available") // available | sold | void; PostgreSQL CHECK constrained
  orderId           Int?      @unique
  soldToUserId      Int?
  soldAt            DateTime?
  createdAt         DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])
  offer   Offer   @relation(fields: [offerId], references: [id])

  // 同一商品的交付内容只能入库一次；应用层预检仅用于友好提示，数据库约束负责并发兜底。
  @@unique([productId, content])
  @@index([offerId, status])
}

model Order {
  id                      Int       @id @default(autoincrement())
  userId                  Int
  productId               Int
  // 下单时选择的 SKU；可空以兼容迁移前订单（回填为默认 Offer，服务层读取
  // 时对 null 回退到商品级快照，惯例同 productNameSnapshot）。
  offerId                 Int?
  offerNameSnapshot       String?
  // P4b：下单时的交付字段模板快照。人工服务发货按它强制校验——商家改模板
  // 不改变已购未发货订单的履约契约（快照惯例同 deliveryModeSnapshot）。
  // null = 纯文本交付契约。
  deliveryFieldsSnapshot  Json?
  price                   Int
  status                  String    @default("pending") // pending | processing | delivered | closed | disputed | refunded
  merchantId              Int?
  commissionRate          Decimal?  @db.Decimal(5, 4)
  commissionAmount        Int       @default(0)
  deliveryModeSnapshot    String    @default("instant_inventory") // 下单时的履约模式快照；服务层保留对迁移前空值的兼容回退
  // 商品可在下单后改名、换图或调整分类；以下字段固定保存当时的展示合同。
  // 允许 null 是为了兼容迁移前订单，读取时回退到关联 Product。
  productNameSnapshot     String?
  productTypeSnapshot     String?
  productIconSnapshot     String?
  productImageUrlSnapshot String?
  holdingPoints           Int? // 虚拟服务订单冻结的积分；instant 模式为 null
  // 购买前表单：下单时把"当时的字段定义 + 买家答案"一并快照，商家改定义不影响已购订单。
  // answers 与 DeliveryRecord.content 同一访问边界：仅买家/商家/必要管理员，
  // 禁止进入商品公开接口、订单列表接口和审计日志。
  purchaseFormSnapshot    Json?
  purchaseFormAnswers     Json?
  fundsHeld               Boolean   @default(false) // 仅新模型订单为 true；兼容迁移前未实际扣减的历史订单
  fulfillmentDeadline     DateTime? // manual_service 商家履约截止时间
  confirmedAt             DateTime? // 用户确认关闭订单的时间
  // P6c：预约日期（购买前表单首个 date 字段的答案，下单校验后列化——
  // 商家排序/提醒 cron 免查 JSON）。null = 非预约单。
  bookingDate             DateTime?
  // P6a：下单时的订阅有效期快照（null = 永久）；到期时刻在 DeliveryRecord.expiresAt。
  validityDaysSnapshot    Int?
  // P6a：续费单指向被续费的原订单（同买家同 offer）。Restrict：续费链是
  // 审计链的一部分，原订单行不可删。
  renewalOfOrderId        Int?
  createdAt               DateTime  @default(now())

  user           User               @relation(fields: [userId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  offer          Offer?             @relation(fields: [offerId], references: [id])
  merchant       Merchant?          @relation(fields: [merchantId], references: [id])
  delivery       DeliveryRecord?
  review         Review?
  settlement     Settlement?
  pointLogs      PointLog[]
  statusEvents   OrderStatusEvent[]
  inventoryLogs  InventoryLog[]
  fileGrants     FileGrantLog[]
  provisionTask   ProvisionTask?
  fakaBridgeTask  FakaBridgeTask?
  pricingSnapshot OrderPricingSnapshot?

  renewalOf            Order?                     @relation("OrderRenewal", fields: [renewalOfOrderId], references: [id], onDelete: Restrict)
  renewals             Order[]                    @relation("OrderRenewal")
  subscriptionReminder SubscriptionReminder?
  slaReminder          SlaReminder?
  bookingReminder      BookingReminder?
  agreementAcceptances OrderAgreementAcceptance[]

  // P5.5：SKU 报表/全平台报表按时间范围聚合的支撑索引（评审修订）。
  @@index([merchantId, createdAt])
  @@index([createdAt])
  @@index([renewalOfOrderId])
  @@index([merchantId, bookingDate])
}

// FakaBridge outbox：下单事务内创建，事务外 HTTP 调用 Xboard 插件。
// 协议与商家 autoProvision 不同（body HMAC + order_no/email/sku），独立表。
// status: pending | succeeded | failed | cancelled | needs_reconcile
model FakaBridgeTask {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  // pending | succeeded | failed | cancelled | needs_reconcile
  status          String    @default("pending")
  // Refund requested while claim/HTTP in flight — worker must not deliver; revoke if opened.
  cancelRequested Boolean   @default(false)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  nextAttemptAt   DateTime  @default(now())
  leaseUntil      DateTime?
  leaseToken      String?
  // 脱敏诊断码（FAKA_*），禁止落远端响应体 / PII 以外快照。
  lastError       String?
  xboardTradeNo   String?
  // 幂等键，稳定为 MN-{orderId}；重试不变。
  requestOrderNo  String
  // 创建时冻结，避免用户改邮箱 / 商家改 SKU 后重试语义漂移。
  emailSnapshot   String
  skuSnapshot     String
  periodSnapshot  String    @default("monthly")
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  // null | pending | succeeded | failed | skipped — 退款后撤 Xboard 订阅
  revokeStatus    String?
  revokeAttempts  Int       @default(0)
  revokedAt       DateTime?
  lastRevokeError String?
  // 对账备注（半成功收敛 / 人工动作）
  reconcileNote   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, cancelRequested])
  @@index([requestOrderNo])
  @@index([xboardTradeNo])
  @@index([revokeStatus])
  @@index([status, completedAt])
}

model DeliveryRecord {
  id                Int       @id @default(autoincrement())
  orderId           Int       @unique
  userId            Int
  productId         Int
  content           String?
  contentType       String    @default("text") // text | url | file
  // P4b：交付时的结构化内容快照 { fields, values }；值与 content 同一访问
  // 边界（仅订单详情，列表剥离）。null = 纯文本交付。
  structuredContent Json?
  status            String    @default("delivered")
  publicNote        String?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  // P5：本单交付的文件（下单冻结的固定文件 / 交付时的人工附件）。
  // 下载授权只认这里；买家窗口从本记录的 deliveredAt 起算。
  fileId            Int?
  // P6a：订阅到期时刻 = 交付时按 Order.validityDaysSnapshot 计算；续费单
  // 且原单未过期时自原到期顺延。null = 永久。到期只作用于内容访问与 UI，
  // 不引入订单状态。
  expiresAt         DateTime?

  order Order         @relation(fields: [orderId], references: [id])
  // Restrict：交付快照引用的文件行不可删——审计链完整性优先于删除便利。
  file  DeliveryFile? @relation("DeliveryRecordFile", fields: [fileId], references: [id], onDelete: Restrict)
}

model OrderStatusEvent {
  id           Int      @id @default(autoincrement())
  orderId      Int
  actorUserId  Int?
  actorRole    String
  fromStatus   String?
  toStatus     String
  action       String
  publicNote   String?
  internalNote String?
  createdAt    DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id])
  actorUser User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
  @@index([actorUserId])
}

model Settlement {
  id               Int       @id @default(autoincrement())
  merchantId       Int
  orderId          Int       @unique
  orderAmount      Int
  commissionRate   Decimal   @db.Decimal(5, 4)
  commissionAmount Int
  settlementAmount Int
  status           String    @default("pending") // pending | settled | holding | voided
  settledAt        DateTime?
  createdAt        DateTime  @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])
}

model CheckinRecord {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String // YYYY-MM-DD
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model InviteRelation {
  id               Int       @id @default(autoincrement())
  inviterId        Int
  inviteeId        Int       @unique
  // Existing relations enter the migration as legacy. New registration and
  // qualification flows select the other closed state values explicitly.
  status           String    @default("legacy") // legacy | pending_verification | qualified | quota_exhausted | voided
  qualifiedAt      DateTime?
  voidedAt         DateTime?
  qualificationDay String? // Asia/Shanghai YYYY-MM-DD; set only when qualified
  createdAt        DateTime  @default(now())

  inviter      User          @relation("inviter", fields: [inviterId], references: [id])
  invitee      User          @relation("invitee", fields: [inviteeId], references: [id])
  growthReward GrowthReward?

  @@index([inviterId, status, qualifiedAt])
  @@index([inviterId, status, qualificationDay])
}

// Source of truth for registration/referral rewards before they become a
// PointLog entry. The later reward service owns all state transitions.
model GrowthReward {
  id               Int       @id @default(autoincrement())
  recipientUserId  Int
  inviteRelationId Int?      @unique
  kind             String // registration | referral
  amount           Int
  state            String    @default("pending_verification") // pending_verification | held | granted | voided
  availableAt      DateTime?
  grantedAt        DateTime?
  voidedAt         DateTime?
  voidReason       String?
  dedupeKey        String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipient      User            @relation("GrowthRewardRecipient", fields: [recipientUserId], references: [id])
  inviteRelation InviteRelation? @relation(fields: [inviteRelationId], references: [id], onDelete: SetNull)

  @@index([state, availableAt])
  @@index([recipientUserId, state, createdAt])
}

// Privacy-preserving registration-abuse evidence. The future event service is
// responsible for its closed vocabulary and detailSafe serializer.
model AbuseEvent {
  id         Int      @id @default(autoincrement())
  type       String
  userId     Int?
  inviterId  Int?
  inviteeId  Int?
  ipHash     String?
  emailHash  String?
  detailSafe Json?
  createdAt  DateTime @default(now())

  // Evidence survives user deletion without preserving a dangling identity.
  user    User? @relation("AbuseEventUser", fields: [userId], references: [id], onDelete: SetNull)
  inviter User? @relation("AbuseEventInviter", fields: [inviterId], references: [id], onDelete: SetNull)
  invitee User? @relation("AbuseEventInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([inviterId, createdAt])
  @@index([createdAt])
}

model AdminLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int
  action      String
  targetType  String?
  targetId    Int?
  detail      String?
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id])
}

model SystemConfig {
  key         String   @id @unique
  value       Int
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   Int?

  updatedByUser User? @relation("SystemConfigUpdatedBy", fields: [updatedBy], references: [id])
}

// P5：受控文件交付的文件登记。对象本体在私有交付桶（DELIVERY_STORAGE_BUCKET，
// 键 = 内容寻址 sha256.ext），本表是引用与生命周期的真相源。
// 行永不物理删除：status 走 active → revoked（管理员吊销，仅管理员可取证下载）
// → deleted（对象已清理，行保留供审计外键）；对象仅在无任何 active/revoked 行
// 引用同 key 时才可删（内容寻址键可能被多商家共享）。
model DeliveryFile {
  id                Int       @id @default(autoincrement())
  key               String
  fileName          String
  size              Int
  mimeType          String
  sha256            String
  merchantId        Int
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?
  // SPEC-STORAGE-001：写入时绑定的提供商；null = legacy env 底座
  storageProviderId Int?

  merchant        Merchant               @relation(fields: [merchantId], references: [id])
  offers          Offer[]                @relation("OfferFixedFile")
  deliveryRecords DeliveryRecord[]       @relation("DeliveryRecordFile")
  grants          FileGrantLog[]
  storageProvider StorageProviderConfig? @relation(fields: [storageProviderId], references: [id], onDelete: SetNull)

  @@index([merchantId, status])
  @@index([key])
  @@index([storageProviderId])
}

// P5：签名发放审计——granted 与 denied 全记，行永不删除。隐私边界：
// ipHash = HMAC(jwtSecret, ip)（同源可关联、不可还原），不存原始 IP；
// UA 截断 ≤256。发放 ≠ 完成下载（字节级事实需 S3 access log，v1 不做）。
model FileGrantLog {
  id        Int       @id @default(autoincrement())
  fileId    Int
  orderId   Int
  userId    Int
  role      String // buyer | merchant | admin
  outcome   String // granted | denied_state | denied_window | denied_revoked
  ipHash    String?
  userAgent String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  file  DeliveryFile @relation(fields: [fileId], references: [id])
  order Order        @relation(fields: [orderId], references: [id])
  user  User         @relation(fields: [userId], references: [id])

  @@index([fileId, createdAt])
  @@index([orderId])
}

// SPEC-LEADERBOARD-001：每日刷新的积分排行榜快照。
// 一行 = 某 (scope, periodKey) 期内某用户的名次与获得积分。
// 快照存**全量**合格且窗口内有得分的用户（不在写侧截断 Top 100），这样
// 「我的排名」是精确值而不是「未上榜」；Top 100 只是读侧的 LIMIT。
// periodKey：'ALL' | 'M<YYYY-MM>' | 'W<周一日历日>'——周用周一日期而非 ISO
// 周号，规避 ISO week-year 的跨年边界（2026-12-28 属 2027-W01 这类）。
model LeaderboardEntry {
  id         Int      @id @default(autoincrement())
  scope      String // total | month | week
  periodKey  String
  rank       Int
  userId     Int
  points     Int // 窗口内 SUM(PointLog.amount) WHERE type='in'
  computedAt DateTime // 本批次刷新时刻，读侧作 updatedAt 下发
  // 上一轮快照同（scope, periodKey）的名次：读侧推导 ↑↓ 变化（prevRank - rank）。
  // 首次入榜为 null；同期每日重刷时即「较昨日」。
  prevRank   Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([scope, periodKey, userId]) // 「我的排名」点查 + 幂等替换的唯一性
  @@index([scope, periodKey, rank]) // Top 100 顺序扫
}

// SPEC-LEGAL-001：协议同意的两层证据模型。
//
// UserAgreementConsent —— 用户对某文档某版本的"长期同意"事实（如注册时的
// 《服务协议》《隐私政策》）。document/version/contentHash 三件套锚定
// 后端 legal 注册表中的不可变版本；同一 (userId, document, version) 唯一，
// 重签新版本会产生新行而不是覆盖旧行（旧版本记录留存作审计）。
//
// OrderAgreementAcceptance —— 与 orderId 绑定的下单确认快照，争议/拒付时
// 证明"该订单"确认了哪些版本。与订单同事务创建、只插入不更新；外键
// Restrict——订单与用户行不可在存在确认记录时被删除。
//
// 两表的 ip/userAgent 是个人信息：仅作同意证据与反滥用审计，retentionUntil
// 到期后由 retentionCron 置空匿名化（document/version/hash/时间保留）。
model UserAgreementConsent {
  id             Int       @id @default(autoincrement())
  userId         Int
  document       String // terms | privacy | refund | points-rules | about
  version        String // 语义化版本，如 '1.0'
  contentHash    String // 公开返回的规范化文档 JSON 的 sha256（hex, 64）
  consentedAt    DateTime  @default(now())
  ip             String? // trust proxy 后的可信客户端 IP
  userAgent      String? // 截断 ≤512
  retentionUntil DateTime? // 到期匿名化锚点（consentedAt + 留存窗口）

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, document, version])
  @@index([retentionUntil])
}

model OrderAgreementAcceptance {
  id             Int       @id @default(autoincrement())
  orderId        Int
  userId         Int // 冗余便于争议检索（与 Order.userId 恒等）
  document       String // terms | refund
  version        String
  contentHash    String
  acceptedAt     DateTime  @default(now())
  ip             String?
  userAgent      String?
  retentionUntil DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([orderId, document])
  @@index([userId])
  @@index([retentionUntil])
}

// SPEC-STORAGE-001：外置对象存储提供商配置（覆盖层）。env/Compose MinIO 底座
// 不写入本表；status=active 至多一行（应用层 + 激活事务保证）。
model StorageProviderConfig {
  id                    Int       @id @default(autoincrement())
  type                  String // r2 | oss | cos | s3_compatible
  name                  String
  status                String    @default("draft") // draft | verified | active | disabled
  configVersion         Int       @default(1)
  publicConfig          Json
  credentialsCiphertext String?
  credentialsKeyVersion Int       @default(1)
  accessKeyLast4        String?
  lastTestAt            DateTime?
  lastTestOk            Boolean?
  lastTestSummary       String?
  verifiedAt            DateTime?
  activatedAt           DateTime?
  disabledAt            DateTime?
  activatedById         Int?
  createdById           Int?
  previousActiveId      Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  storedObjects StoredObject[]
  deliveryFiles DeliveryFile[]

  @@index([status])
}

// SPEC-STORAGE-001：单行运行时指针（id 恒为 1）。
model StorageRuntime {
  id             Int      @id @default(1)
  activeConfigId Int?
  configVersion  Int      @default(0)
  updatedAt      DateTime @default(now()) @updatedAt
}

// SPEC-STORAGE-001：对象位置登记。读路径按 providerConfigId 路由；
// providerConfigId null + providerRef='env' 表示 legacy env 底座（临时兼容）。
// providerRef 避免 PG 对 NULL 唯一约束的不确定性（'env' | String(id)）。
model StoredObject {
  id               Int      @id @default(autoincrement())
  providerConfigId Int?
  providerRef      String   @default("env") // env | <configId>
  bucketRole       String // public | private
  objectKey        String
  size             Int?
  checksum         String?
  mimeType         String?
  status           String   @default("active") // active | deleted
  source           String? // upload_image | delivery_file
  sourceId         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  provider StorageProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)

  @@unique([bucketRole, objectKey, providerRef])
  @@index([objectKey])
  @@index([providerConfigId])
  @@index([source, sourceId])
}

// ═══════════════════════════════════════════════════════════════════════════
// FND-CMI-001 F0 — Catalog / Merchandising Shared Foundation.
// Frozen model set per SPEC-CATALOG-OPS-001 §5 and SPEC-MERCH-001 §5.
// Prisma-unexpressible CHECK constraints, partial unique indexes and DESC
// indexes are implemented in the matching wave migrations (raw SQL only).
// ═══════════════════════════════════════════════════════════════════════════

// 平台治理分类（SPEC-CATALOG-OPS-001 §5.1）。code 不可变、不复用；
// status active|inactive；被 Product/申请引用时禁止物理删除。
model ProductCategory {
  id              Int      @id @default(autoincrement())
  code            String   @unique // ^[a-z][a-z0-9_-]{1,63}$ ASCII stable, immutable
  label           String // 1..50 Unicode code points
  normalizedLabel String   @unique // lower/trim canonical, UNIQUE
  description     String? // <=500
  iconKey         String? // <=64
  defaultCoverUrl String? // platform public asset only
  sortOrder       Int      @default(0)
  status          String   @default("active") // active | inactive; PostgreSQL CHECK constrained
  createdByUserId Int
  updatedByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdByUser User @relation("CategoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User @relation("CategoryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  products               Product[]
  merchandisingSnapshots ProductMerchandisingSnapshot[]
  approvedApplications   CategoryApplication[]          @relation("ApplicationApprovedCategory")

  @@index([status, sortOrder, id])
}

// 商家分类申请（SPEC-CATALOG-OPS-001 §5.2）。同一 merchant + normalizedLabel
// 同时最多一条 pending（partial unique，raw SQL）。
model CategoryApplication {
  id                 Int       @id @default(autoincrement())
  merchantId         Int
  proposedLabel      String // 1..50
  normalizedLabel    String // lower/trim canonical
  proposedCode       String? // 仅建议，平台可调整
  description        String // 20..1000
  exampleProducts    String? // <=1000
  status             String    @default("pending") // pending | approved | rejected | withdrawn; CHECK
  resolution         String? // create_new | map_existing | null; CHECK
  approvedCategoryId Int?
  reviewedByUserId   Int?
  reviewedAt         DateTime?
  reviewReason       String? // 1..500
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  merchant         Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  approvedCategory ProductCategory? @relation("ApplicationApprovedCategory", fields: [approvedCategoryId], references: [id], onDelete: Restrict)
  reviewedByUser   User?            @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([merchantId, status])
  @@index([reviewedByUserId])
}

// Xboard 导入的外部目录身份与幂等（SPEC-CATALOG-OPS-001 §5.4）。
// productId UNIQUE（1:1）；UNIQUE(provider, externalProductId) 与
// UNIQUE(provider, idempotencyKey) 为数据库层权威映射。
model ExternalCatalogLink {
  id                Int      @id @default(autoincrement())
  provider          String // P0 固定 faka_bridge
  externalProductId String // Xboard plan_id canonical decimal string
  productId         Int      @unique
  sourceHash        String // normalized source SHA-256
  sourceSnapshot    Json // allowlist metadata, no secret/HTML
  idempotencyKey    String
  requestHash       String
  importedByUserId  Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  importedByUser User    @relation(fields: [importedByUserId], references: [id], onDelete: Restrict)

  @@unique([provider, externalProductId])
  @@unique([provider, idempotencyKey])
  @@index([importedByUserId])
}

// Faka incremental-sync idempotency. Distinct from import ExternalCatalogLink
// keys; UNIQUE(provider, idempotencyKey) is the concurrent claim authority.
model ExternalCatalogSyncIdempotency {
  id             Int      @id @default(autoincrement())
  provider       String
  productId      Int
  idempotencyKey String
  requestHash    String
  sourceHash     String
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([provider, idempotencyKey])
  @@index([productId])
}

// 自然热卖排名 run（SPEC-MERCH-001 §5.1）。UUID PK；全局 single-running
// partial unique、terminal status CHECK、DESC 查询索引均为 raw SQL。
model MerchandisingRun {
  id          String    @id @default(uuid()) @db.Uuid
  status      String // running | completed | failed; PostgreSQL CHECK constrained
  windowStart DateTime
  windowEnd   DateTime
  windowDays  Int
  minSales    Int
  topPercent  Int
  startedAt   DateTime
  completedAt DateTime?
  failedAt    DateTime?
  failureCode String? // 脱敏枚举
  createdAt   DateTime  @default(now())

  snapshots ProductMerchandisingSnapshot[]

  @@index([status, completedAt(sort: Desc), id(sort: Desc)])
}

// 单 run 内某商品的排名快照（SPEC-MERCH-001 §5.2）。
// categoryId 是计算时点分类分区快照；run 完成后不可更新。
model ProductMerchandisingSnapshot {
  runId               String   @db.Uuid
  productId           Int
  categoryId          Int
  effectiveOrderCount Int // >= 0; PostgreSQL CHECK constrained
  categoryRank        Int // >= 1; PostgreSQL CHECK constrained
  categoryPopulation  Int // >= 1; PostgreSQL CHECK constrained
  isHot               Boolean
  computedAt          DateTime

  run      MerchandisingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([runId, productId])
  @@index([runId, categoryId, isHot, effectiveOrderCount, productId])
}

// 积分推广套餐（SPEC-MERCH-001 §5.3）。code immutable；价格/时长由服务端快照。
model PromotionPackage {
  id              Int      @id @default(autoincrement())
  code            String   @unique // immutable
  label           String
  placement       String // store_home_sponsored | category_sponsored; CHECK
  durationDays    Int // 1..90; PostgreSQL CHECK constrained
  pricePoints     Int // > 0; PostgreSQL CHECK constrained
  description     String // <=1000
  sortOrder       Int      @default(0)
  status          String   @default("active") // active | inactive; CHECK
  createdByUserId Int
  updatedByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdByUser User @relation("PromotionPackageCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User @relation("PromotionPackageUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  campaigns PromotionCampaign[]

  @@index([placement, status, sortOrder])
}

// 商家推广活动（SPEC-MERCH-001 §5.4）。scheduled|active|paused 同
// (productId, placementSnapshot) 最多一行（partial unique，raw SQL）。
// charge/refund PointLog FK 为审计友好的 RESTRICT + UNIQUE。
model PromotionCampaign {
  id                       Int       @id @default(autoincrement())
  merchantId               Int
  productId                Int
  packageId                Int
  packageCodeSnapshot      String
  placementSnapshot        String
  durationDaysSnapshot     Int
  pricePointsSnapshot      Int
  requestIdempotencyKey    String
  requestPayloadHash       String // 64 lowercase hex; PostgreSQL CHECK constrained
  status                   String // pending_review | payment_failed | scheduled | active | paused | expired | rejected | cancelled; CHECK
  requestedStartAt         DateTime?
  startsAt                 DateTime?
  endsAt                   DateTime?
  reviewedByUserId         Int?
  reviewedAt               DateTime?
  reviewReason             String?
  chargePointLogId         Int?      @unique
  chargedPoints            Int       @default(0)
  refundedPoints           Int       @default(0)
  refundPointLogId         Int?      @unique
  adjustmentDecidedAt      DateTime?
  adjustmentByUserId       Int?
  adjustmentReason         String?
  adjustmentIdempotencyKey String?
  adjustmentPayloadHash    String?
  cancelledByUserId        Int?
  cancellationReason       String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  merchant         Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  package          PromotionPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  reviewedByUser   User?            @relation("CampaignReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  chargePointLog   PointLog?        @relation("PromotionCampaignCharge", fields: [chargePointLogId], references: [id], onDelete: Restrict)
  refundPointLog   PointLog?        @relation("PromotionCampaignRefund", fields: [refundPointLogId], references: [id], onDelete: Restrict)
  adjustmentByUser User?            @relation("CampaignAdjustmentBy", fields: [adjustmentByUserId], references: [id], onDelete: Restrict)
  cancelledByUser  User?            @relation("CampaignCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@unique([merchantId, requestIdempotencyKey])
  @@index([productId, status])
  @@index([packageId])
  @@index([status, startsAt])
}

// 平台精选（SPEC-MERCH-001 §5.5）。仅 admin 可创建/排期/撤销。
model EditorialFeature {
  id              Int      @id @default(autoincrement())
  productId       Int
  placement       String // store_editorial | category_editorial; CHECK
  status          String // scheduled | active | revoked | expired; CHECK
  startsAt        DateTime
  endsAt          DateTime
  sortWeight      Int      @default(0)
  publicReason    String? // <=120
  internalReason  String // 1..500
  createdByUserId Int
  revokedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User    @relation("EditorialCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedByUser User?   @relation("EditorialRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([placement, status, startsAt])
}

// 合作伙伴权益（SPEC-MERCH-001 §5.6）。同 merchant+code 同时最多一个 active
// （partial unique，raw SQL）；自动重算以幂等 upsert/expire 维护历史。
model MerchantEntitlement {
  id              Int      @id @default(autoincrement())
  merchantId      Int
  code            String // partner; CHECK
  source          String // promotion_spend | admin_grant; CHECK
  sourceRef       String?
  status          String // active | expired | revoked; CHECK
  validFrom       DateTime
  validUntil      DateTime
  reason          String // <=500
  grantedByUserId Int?
  revokedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  grantedByUser User?    @relation("EntitlementGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedByUser User?    @relation("EntitlementRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([merchantId, status])
  @@index([code, status])
}

// ---------------------------------------------------------------------------
// SPEC-VALUE-POLICY-P1-001: CNY reference-value foundation.
// Additive only. Do not seed a production active ValuePolicy here.
// ---------------------------------------------------------------------------

enum AssetKind {
  reward_point
  fiat
}

enum ValuePolicyStatus {
  draft
  approved
  scheduled
  active
  retired
}

enum MoneyRoundingMode {
  HALF_EVEN
}

model AssetDefinition {
  code      String    @id
  kind      AssetKind
  scale     Int
  enabled   Boolean   @default(false)
  createdAt DateTime  @default(now())
  retiredAt DateTime?

  pointPolicies            ValuePolicy[]          @relation("PolicyPointAsset")
  referencePolicies        ValuePolicy[]          @relation("PolicyReferenceAsset")
  snapshotPointsAssets     OrderPricingSnapshot[] @relation("SnapshotPointsAsset")
  snapshotReferenceAssets  OrderPricingSnapshot[] @relation("SnapshotReferenceAsset")
}

model ValuePolicy {
  id                                 String            @id
  version                            Int               @unique
  pointAssetCode                     String
  referenceAssetCode                 String
  referenceAtomicPerPointNumerator   BigInt
  referenceAtomicPerPointDenominator BigInt
  roundingMode                       MoneyRoundingMode @default(HALF_EVEN)
  status                             ValuePolicyStatus @default(draft)
  effectiveAt                        DateTime
  approvedAt                         DateTime?
  activatedAt                        DateTime?
  retiredAt                          DateTime?
  createdAt                          DateTime          @default(now())
  createdByUserId                    Int
  approvedByUserId                   Int?
  scheduledByUserId                  Int?
  activatedByUserId                  Int?
  retiredByUserId                    Int?
  d02DecisionRecordRef               String
  d02DecisionRecordSha256            String            @db.Char(64)
  d03DecisionRecordRef               String
  d03DecisionRecordSha256            String            @db.Char(64)
  disclosureVersion                  String

  pointAsset         AssetDefinition                @relation("PolicyPointAsset", fields: [pointAssetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  referenceAsset     AssetDefinition                @relation("PolicyReferenceAsset", fields: [referenceAssetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  pricingSnapshots   OrderPricingSnapshot[]
  createdByUser      User                           @relation("ValuePolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedByUser     User?                          @relation("ValuePolicyApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scheduledByUser    User?                          @relation("ValuePolicyScheduledBy", fields: [scheduledByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activatedByUser    User?                          @relation("ValuePolicyActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  retiredByUser      User?                          @relation("ValuePolicyRetiredBy", fields: [retiredByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  governanceCommands ValuePolicyGovernanceCommand[]
  governanceEvents   ValuePolicyGovernanceEvent[]

  @@index([status, referenceAssetCode])
  @@index([pointAssetCode, status])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([activatedByUserId])
}

model ValuePolicyGovernanceCommand {
  id             Int      @id @default(autoincrement())
  valuePolicyId  String
  actorUserId    Int
  idempotencyKey String
  payloadHash    String   @db.Char(64)
  action         String
  result         Json
  createdAt      DateTime @default(now())

  valuePolicy ValuePolicy                 @relation(fields: [valuePolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User                        @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event       ValuePolicyGovernanceEvent?

  @@unique([actorUserId, idempotencyKey])
  @@index([valuePolicyId, createdAt])
}

model ValuePolicyGovernanceEvent {
  id            BigInt             @id @default(autoincrement())
  valuePolicyId String
  commandId     Int                @unique
  actorUserId   Int
  action        String
  fromStatus    ValuePolicyStatus?
  toStatus      ValuePolicyStatus
  reason        String
  occurredAt    DateTime           @default(now())

  valuePolicy ValuePolicy                  @relation(fields: [valuePolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  command     ValuePolicyGovernanceCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User                         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([valuePolicyId, occurredAt, id])
  @@index([actorUserId, occurredAt])
}

model OrderPricingSnapshot {
  orderId               Int               @id
  pointsAssetCode       String
  pointsAmountAtomic    BigInt
  valuePolicyId         String
  referenceAssetCode    String
  referenceAmountAtomic BigInt
  roundingMode          MoneyRoundingMode
  createdAt             DateTime          @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  valuePolicy    ValuePolicy     @relation(fields: [valuePolicyId], references: [id], onDelete: Restrict)
  pointsAsset    AssetDefinition @relation("SnapshotPointsAsset", fields: [pointsAssetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  referenceAsset AssetDefinition @relation("SnapshotReferenceAsset", fields: [referenceAssetCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
}

// ---------------------------------------------------------------------------
// SPEC-RECHARGE-PAYMENT-V1.2: payment/recharge foundation.
// Additive only. Do not seed an active live provider or real orders.
// Partial unique indexes live in the SQL migration (Prisma cannot express WHERE).
// ---------------------------------------------------------------------------

model RechargePricePolicy {
  id                 String            @id @default(uuid()) @db.Uuid
  code               String            @unique
  version            Int
  currency           String            @db.Char(3)
  adminSandbox       Boolean           @default(false)
  currencyScale      Int
  pointsNumerator    BigInt
  pointsDenominator  BigInt
  roundingMode       MoneyRoundingMode @default(HALF_EVEN)
  minAmountMinor     BigInt
  maxAmountMinor     BigInt
  amountStepMinor    BigInt
  dailyLimitMinor    BigInt
  monthlyLimitMinor  BigInt
  limitTimeZone      String
  bonusRuleVersion   String?
  status             String
  effectiveAt        DateTime
  createdAt          DateTime          @default(now())

  suggestedAmounts RechargeSuggestedAmount[]
  quotes           RechargeQuote[]
  orders           RechargeOrder[]

  @@unique([currency, adminSandbox, version])
  @@index([currency, adminSandbox, status])
  // One active policy per currency and policy lane: recharge_price_policy_one_active_per_lane
  // (SQL migration; Prisma cannot express WHERE status = 'active').
}

model RechargeSuggestedAmount {
  id          String @id @default(uuid()) @db.Uuid
  policyId    String @db.Uuid
  amountMinor BigInt
  sortOrder   Int

  policy RechargePricePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([policyId, amountMinor])
  @@index([policyId, sortOrder])
}

model RechargeQuote {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  Int
  pricePolicyId           String    @db.Uuid
  provider                String
  paymentMethod           String
  providerAccountKey      String
  capabilityVersion       String
  capabilityDigest        String
  currency                String    @db.Char(3)
  amountMinor             BigInt
  effectiveMinAmountMinor BigInt
  effectiveMaxAmountMinor BigInt
  basePoints              BigInt
  bonusPoints             BigInt
  totalPoints             BigInt
  amountSource            String
  adminSandbox            Boolean   @default(false)
  expiresAt               DateTime
  consumedAt              DateTime?
  createdAt               DateTime  @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  pricePolicy RechargePricePolicy @relation(fields: [pricePolicyId], references: [id], onDelete: Restrict)
  order       RechargeOrder?

  @@index([userId, expiresAt])
  @@index([pricePolicyId])
}

model RechargeOrder {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  Int
  quoteId                 String    @unique @db.Uuid
  pricePolicyId           String    @db.Uuid
  currency                String    @db.Char(3)
  amountMinor             BigInt
  basePoints              BigInt
  bonusPoints             BigInt
  totalPoints             BigInt
  pricePolicyCode         String
  pricePolicyVersion      Int
  pointsNumerator         BigInt
  pointsDenominator       BigInt
  roundingMode            MoneyRoundingMode
  currencyScale           Int
  bonusRuleVersion        String?
  amountSource            String
  adminSandbox            Boolean   @default(false)
  provider                String
  paymentMethod           String
  providerAccountKey      String
  capabilityVersion       String
  capabilityDigest        String
  effectiveMinAmountMinor BigInt
  effectiveMaxAmountMinor BigInt
  disclosureVersion       String
  status                  String
  expiresAt               DateTime
  paidAt                  DateTime?
  creditedAt              DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user              User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  quote             RechargeQuote              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  pricePolicy       RechargePricePolicy        @relation(fields: [pricePolicyId], references: [id], onDelete: Restrict)
  paymentIntent     PaymentIntent?
  credit            RechargeCredit?
  refund            RechargeRefund?
  creditTask        RechargeCreditTask?
  disputes          PaymentDispute[]
  limitReservations RechargeLimitReservation[]
  reconciliationItems ReconciliationItem[]

  @@index([userId, createdAt])
  @@index([status, creditedAt, updatedAt])
  @@index([provider, providerAccountKey, status])
}

model PaymentIntent {
  id              String    @id @default(uuid()) @db.Uuid
  rechargeOrderId String    @unique @db.Uuid
  amountMinor     BigInt
  currency        String    @db.Char(3)
  status          String
  activeAttemptId String?   @db.Uuid
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rechargeOrder RechargeOrder    @relation(fields: [rechargeOrderId], references: [id], onDelete: Restrict)
  attempts      PaymentAttempt[]
  credit        RechargeCredit?

  @@index([status, expiresAt])
}

model PaymentAttempt {
  id                          String    @id @default(uuid()) @db.Uuid
  paymentIntentId             String    @db.Uuid
  provider                    String
  providerAccountKey          String
  method                      String
  status                      String
  providerPaymentId           String?
  providerOrderId             String?
  providerCaptureId           String?
  requestIdempotencyKey       String
  actionType                  String
  actionPayload               String?
  lastErrorCode               String?
  lastErrorSafeMessage        String?
  expectedProviderAmountMinor BigInt
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  completedAt                 DateTime?

  paymentIntent       PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  events              PaymentEvent[]
  refunds             RechargeRefund[]
  disputes            PaymentDispute[]
  reconciliationItems ReconciliationItem[]

  @@unique([provider, providerAccountKey, requestIdempotencyKey])
  @@index([paymentIntentId, status])
  @@index([provider, providerAccountKey, status])
  // Partial uniques in SQL: (provider, providerAccountKey, providerPaymentId)
  // WHERE providerPaymentId IS NOT NULL; one non-terminal attempt per intent.
}

model PaymentEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  provider             String
  providerAccountKey   String
  source               String
  verificationMethod   String
  paymentAttemptId     String?   @db.Uuid
  providerPaymentId    String?
  providerCaptureId    String?
  providerEventId      String?
  dedupeKey            String
  eventType            String
  payloadSha256        String    @db.Char(64)
  rawPayloadEncrypted  String?
  normalizedPayload    Json
  signatureVerified    Boolean?
  status               String
  attempts             Int       @default(0)
  nextAttemptAt        DateTime  @default(now())
  leaseToken           String?   @db.Uuid
  leaseUntil           DateTime?
  observedAt           DateTime
  createdAt            DateTime  @default(now())
  processedAt          DateTime?
  lastErrorCode        String?

  paymentAttempt      PaymentAttempt?      @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  reconciliationItems ReconciliationItem[]

  @@unique([provider, providerAccountKey, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([paymentAttemptId])
  @@index([provider, providerPaymentId])
}

model RechargeCredit {
  id               String    @id @default(uuid()) @db.Uuid
  rechargeOrderId  String    @unique @db.Uuid
  paymentIntentId  String    @unique @db.Uuid
  userId           Int
  points           BigInt
  adminSandbox     Boolean   @default(false)
  balanceBefore    Int
  balanceAfter     Int
  businessEventKey String    @unique
  pointLogId       Int       @unique
  createdAt        DateTime  @default(now())
  reversedAt       DateTime?

  rechargeOrder RechargeOrder          @relation(fields: [rechargeOrderId], references: [id], onDelete: Restrict)
  paymentIntent PaymentIntent          @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  pointLog      PointLog               @relation(fields: [pointLogId], references: [id], onDelete: Restrict)
  reversal      RechargeReversal?
  recoveryCases PaymentRecoveryCase[]

  @@index([userId, createdAt])
}

model RechargeRefund {
  id                    String    @id @default(uuid()) @db.Uuid
  rechargeOrderId       String    @unique @db.Uuid
  paymentAttemptId      String    @db.Uuid
  providerRefundId      String?
  requestIdempotencyKey String
  amountMinor           BigInt
  pointsToReverse       BigInt
  status                String
  reasonCode            String
  createdByUserId       Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  completedAt           DateTime?

  rechargeOrder  RechargeOrder     @relation(fields: [rechargeOrderId], references: [id], onDelete: Restrict)
  paymentAttempt PaymentAttempt    @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  createdByUser  User              @relation("RechargeRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversal       RechargeReversal?

  @@unique([rechargeOrderId, requestIdempotencyKey])
  @@index([status, createdAt])
}

model PointHold {
  id         String   @id @default(uuid()) @db.Uuid
  userId     Int
  sourceType String
  sourceId   String   @db.Uuid
  points     BigInt
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId])
  @@index([userId, status])
}

model RechargeReversal {
  id               String   @id @default(uuid()) @db.Uuid
  rechargeRefundId String   @unique @db.Uuid
  rechargeCreditId String   @unique @db.Uuid
  userId           Int
  points           BigInt
  balanceBefore    Int
  balanceAfter     Int
  businessEventKey String   @unique
  pointLogId       Int      @unique
  createdAt        DateTime @default(now())

  rechargeRefund RechargeRefund @relation(fields: [rechargeRefundId], references: [id], onDelete: Restrict)
  rechargeCredit RechargeCredit @relation(fields: [rechargeCreditId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  pointLog       PointLog       @relation(fields: [pointLogId], references: [id], onDelete: Restrict)
}

model PaymentDispute {
  id                  String    @id @default(uuid()) @db.Uuid
  provider            String
  providerAccountKey  String
  providerDisputeId   String
  rechargeOrderId     String    @db.Uuid
  paymentAttemptId    String?   @db.Uuid
  amountMinor         BigInt
  currency            String    @db.Char(3)
  status              String
  reasonCode          String?
  evidenceDueAt       DateTime?
  openedAt            DateTime
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  rechargeOrder RechargeOrder        @relation(fields: [rechargeOrderId], references: [id], onDelete: Restrict)
  paymentAttempt PaymentAttempt?     @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  recoveryCase  PaymentRecoveryCase?

  @@unique([provider, providerAccountKey, providerDisputeId])
  @@index([status, evidenceDueAt])
  @@index([rechargeOrderId])
}

model PaymentRecoveryCase {
  id                 String    @id @default(uuid()) @db.Uuid
  paymentDisputeId   String    @unique @db.Uuid
  rechargeCreditId   String    @db.Uuid
  userId             Int
  pointsToRecover    BigInt
  pointsHeld         BigInt
  outstandingPoints  BigInt
  lossAmountMinor    BigInt
  currency           String    @db.Char(3)
  status             String
  resolutionReason   String?
  resolvedByUserId   Int?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  paymentDispute PaymentDispute @relation(fields: [paymentDisputeId], references: [id], onDelete: Restrict)
  rechargeCredit RechargeCredit @relation(fields: [rechargeCreditId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  resolvedByUser User?          @relation("PaymentRecoveryCaseResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

model AccountRestriction {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             Int
  sourceType         String
  sourceId           String    @db.Uuid
  blocksPointSpending Boolean
  blocksRecharge     Boolean
  status             String
  releasedByUserId   Int?
  releasedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user           User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  releasedByUser User? @relation("AccountRestrictionReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId])
  @@index([userId, status])
}

model ReconciliationRun {
  id                 String    @id @default(uuid()) @db.Uuid
  provider           String
  providerAccountKey String
  environment        String
  scopeType          String
  scopeKey           String
  periodStart        DateTime?
  periodEnd          DateTime?
  status             String
  sourceSha256       String?   @db.Char(64)
  itemCount          Int       @default(0)
  mismatchCount      Int       @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdByUserId    Int?
  lastErrorCode      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdByUser User?                @relation("ReconciliationRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items         ReconciliationItem[]

  @@unique([provider, providerAccountKey, environment, scopeType, scopeKey])
  @@index([status, createdAt])
}

model ReconciliationItem {
  id                  String    @id @default(uuid()) @db.Uuid
  reconciliationRunId String    @db.Uuid
  providerEntryKey    String
  rechargeOrderId     String?   @db.Uuid
  paymentAttemptId    String?   @db.Uuid
  paymentEventId      String?   @db.Uuid
  mismatchType        String
  providerStatus      String?
  localStatus         String?
  providerAmountMinor BigInt?
  localAmountMinor    BigInt?
  quotedAmountMinor   BigInt?
  currency            String?   @db.Char(3)
  status              String
  resolutionReason    String?
  resolvedByUserId    Int?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reconciliationRun ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Restrict)
  rechargeOrder     RechargeOrder?    @relation(fields: [rechargeOrderId], references: [id], onDelete: SetNull)
  paymentAttempt    PaymentAttempt?   @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  paymentEvent      PaymentEvent?     @relation(fields: [paymentEventId], references: [id], onDelete: SetNull)
  resolvedByUser    User?             @relation("ReconciliationItemResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@unique([reconciliationRunId, providerEntryKey, mismatchType])
  @@index([status, mismatchType])
  @@index([rechargeOrderId])
}

model RechargeLimitBucket {
  id             String   @id @default(uuid()) @db.Uuid
  userId         Int
  currency       String   @db.Char(3)
  periodType     String
  periodStart    DateTime
  periodEnd      DateTime
  reservedMinor  BigInt
  consumedMinor  BigInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservations  RechargeLimitReservation[]

  @@unique([userId, currency, periodType, periodStart])
  @@index([userId, currency, periodType])
}

model RechargeLimitReservation {
  id              String    @id @default(uuid()) @db.Uuid
  rechargeOrderId String    @db.Uuid
  bucketId        String    @db.Uuid
  periodType      String
  amountMinor     BigInt
  status          String
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rechargeOrder RechargeOrder       @relation(fields: [rechargeOrderId], references: [id], onDelete: Restrict)
  bucket        RechargeLimitBucket @relation(fields: [bucketId], references: [id], onDelete: Restrict)

  @@unique([rechargeOrderId, periodType])
  @@index([bucketId, status])
}

model RechargeCreditTask {
  id              String    @id @default(uuid()) @db.Uuid
  rechargeOrderId String    @unique @db.Uuid
  status          String
  attempts        Int       @default(0)
  maxAttempts     Int       @default(8)
  nextAttemptAt   DateTime  @default(now())
  leaseToken      String?   @db.Uuid
  leaseUntil      DateTime?
  lastErrorCode   String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  rechargeOrder RechargeOrder @relation(fields: [rechargeOrderId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

model RechargeIdempotencyRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        Int
  scope         String
  key           String    @db.Uuid
  requestDigest String
  status        String
  claimToken    String    @db.Uuid
  resultType    String
  resultId      String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@index([status, expiresAt])
}
