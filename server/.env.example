NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/monexus?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# --- Administrator MFA encryption key (M3-ISH) ---
# Required in production. Generate a fresh 32-byte standard-base64 value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# All API instances must use the same secret-store value. Never commit a real
# value or reuse this example as a production key.
# MFA_ENCRYPTION_KEY=

# --- Trust proxy (M3-S3) ---
# In production behind nginx the server sees requests from the proxy's
# internal IP; setting TRUST_PROXY=1 lets Express parse X-Forwarded-For
# (set by nginx) so express-rate-limit keys on the real client IP. Set to
# false for direct connections (no proxy). Defaults to false in dev/test.
# Accepts a non-negative integer (number of trusted hops) or boolean.
TRUST_PROXY=false

# --- Auth performance / status cache (M3-A5) ---
# TTL (seconds) for the in-memory User.status LRU cache that powers
# `requireActiveUser`. 0 disables the cache and every protected request
# hits Prisma — equivalent to pre-M3 behavior. 60 (default) is a sensible
# production value: ban / unban / password-change paths invalidate
# explicitly, so the TTL only bounds how long a status mutation that
# happens *outside* those paths (e.g. raw DB edit) takes to propagate.
USER_STATUS_CACHE_TTL_SEC=60

# --- Object storage (P0-C) ---
# Optional in dev: leave all unset to fall back to an in-memory adapter.
# Required in production (server refuses to boot if NODE_ENV=production
# and any of these four are missing).
#
# Local development with `docker compose up`:
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_BUCKET=monexus-uploads
#   STORAGE_ACCESS_KEY=minio
#   STORAGE_SECRET_KEY=minio_dev_password
#   STORAGE_PUBLIC_URL_BASE=http://localhost:9000/monexus-uploads
#
# STORAGE_ENDPOINT=
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_URL_BASE=
# STORAGE_FORCE_PATH_STYLE=true

# --- P5 controlled file delivery (private bucket) ---
# Optional: unset falls back to an in-memory adapter (dev/test only).
# DELIVERY_STORAGE_BUCKET must differ from STORAGE_BUCKET — the public
# bucket carries an anonymous-download policy that would expose paid files;
# startup refuses same-name configs. DELIVERY_STORAGE_PUBLIC_ENDPOINT is
# the browser-reachable origin used ONLY to presign download URLs (SigV4
# signs the Host); in production this is the public site origin that nginx
# passes through verbatim to MinIO.
#
# Local development with `docker compose up`:
#   DELIVERY_STORAGE_BUCKET=monexus-files
#   DELIVERY_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
#
# DELIVERY_STORAGE_BUCKET=
# DELIVERY_STORAGE_PUBLIC_ENDPOINT=

# --- SPEC-STORAGE-001: object storage console (overlay on env bootstrap) ---
# STORAGE_UI_CONFIG_ENABLED=true
# STORAGE_CONFIG_SOURCE=database   # env = force bootstrap only (circuit breaker)
# STORAGE_CREDENTIALS_ENC_KEY=     # 64 hex chars (32 bytes); required for UI writes in production
# STORAGE_CREDENTIALS_ENC_KEY_VERSION=1
# STORAGE_CREDENTIALS_ENC_KEY_PREVIOUS=           # optional previous key during rotation
# STORAGE_CREDENTIALS_ENC_KEY_PREVIOUS_VERSION=   # version embedded in old ciphertext
# STORAGE_ENDPOINT_ALLOWLIST=minio,minio.internal
#   single-label (minio) = exact Docker hostname only;
#   multi-label (minio.internal) = exact or *.minio.internal; never bare TLD (com)

# --- Transactional email / SMTP (M3-A1) ---
# Optional in dev: leave SMTP_HOST unset and the server uses a console
# mailer that logs to stdout (good enough for password-reset / verify
# flows during development). Set SMTP_HOST to opt into real delivery
# via nodemailer.
#
# Local dev recipe (MailHog SMTP catcher with web UI on :8025):
#   docker run --rm -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_SECURE=false
#   # MailHog accepts unauthenticated submissions — leave USER/PASS unset.
#   SMTP_FROM=noreply@monexus.local
#   SMTP_FROM_NAME=MoNexus
#   # Inbox shows "MoNexus" as the sender name; SMTP_FROM is the address only.
#   # SMTP_FROM_NAME defaults to MoNexus when unset; set empty to send bare address.
#
# Production examples (provider docs are authoritative):
#   - AWS SES SMTP:  SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587 SMTP_SECURE=false (STARTTLS)
#   - Mailtrap:      SMTP_HOST=sandbox.smtp.mailtrap.io           SMTP_PORT=2525 SMTP_SECURE=false
#   - Gmail SMTP:    SMTP_HOST=smtp.gmail.com                     SMTP_PORT=465 SMTP_SECURE=true
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=<set-provider-password-or-token>
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=MoNexus

# --- Registration abuse protection (SPEC-RAP-001) ---
# Local development stays explicitly off by default. Production refuses to
# boot unless this is `enforce`, Redis is enabled/required, and all three
# Turnstile values plus ABUSE_HASH_KEY are present.
ABUSE_PROTECTION_MODE=off
# Generate a separate 32-byte standard-base64 HMAC key when testing enforce:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ABUSE_HASH_KEY=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames only; no scheme/path/port/wildcard.
# TURNSTILE_ALLOWED_HOSTNAMES=localhost

# --- Legal pages & consent (SPEC-LEGAL-001) ---
# Master switch for the five public legal documents and the registration /
# checkout consent collection. `enforce` requires clients to confirm the
# current document versions at register/order time (missing = 400
# LEGAL_AGREEMENT_REQUIRED, stale = 409 LEGAL_AGREEMENT_STALE); `off` only
# records what clients submit. Production refuses to boot when enabled
# without enforce. LEGAL_PAGES_FIXTURE_PATH overrides the built-in document
# drafts with <slug>.json files from a directory (test escape hatch;
# production refuses to boot when set).
LEGAL_PAGES_ENABLED=false
LEGAL_PAGES_ENFORCEMENT=off
# LEGAL_PAGES_FIXTURE_PATH=

# Base URL written into email links (password reset, verify email).
# Falls back to FRONTEND_ORIGIN when unset. Override only when the
# user-facing link host differs from the CORS origin (e.g. behind a
# CDN with a different hostname for transactional links).
# APP_BASE_URL=

# --- Error reporting / Sentry (M2 GA; documented in M3) ---
# Optional. Leave unset in local dev so backend errors don't get sent
# anywhere. In staging / prod, set to your Sentry or self-hosted
# GlitchTip project DSN. Errors flow via `@sentry/node`.
# SENTRY_DSN=https://<key>@<host>/<project>

# --- Logging (M2 GA) ---
# pino log level. One of: fatal | error | warn | info | debug | trace | silent.
# Defaults to "info". Raise to "debug" or "trace" only when chasing
# specific issues — `trace` is very chatty.
# LOG_LEVEL=info

# --- Metrics endpoint protection (M4-A3) ---
# GET /api/metrics requires 'Authorization: Bearer <token>'. It is required
# in production; leave it unset only for local development or isolated test
# runs. Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# --- Redis public read cache ---
# Disabled by default. Enable for local cache testing after starting Redis
# with `docker compose up -d redis`.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=100
REDIS_COMMAND_TIMEOUT_MS=80
REDIS_CIRCUIT_ERROR_THRESHOLD=5
REDIS_CIRCUIT_OPEN_MS=30000
CACHE_KEY_PREFIX=monexus:local
CACHE_PRODUCT_LIST=true
CACHE_PRODUCT_DETAIL=true
CACHE_PRODUCT_REVIEWS=true
CACHE_PRODUCT_LIST_VERSION_COALESCE_MS=10000
CACHE_MAX_VALUE_BYTES=524288
