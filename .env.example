# =============================================================================
# MoNexus — production environment variables
#
# Copy to `.env` (at repo root) and fill in real values before running
# `docker compose -f docker-compose.prod.yml up -d`. The `.env` file is in
# .gitignore so secrets never get committed.
# Validate before any production compose start:
#   npm run prod:env -- --mode production --env-file .env
# =============================================================================

# --- Database ---
POSTGRES_USER=monexus
POSTGRES_PASSWORD=<set-strong-random-password>
POSTGRES_DB=monexus

# --- Server ---
# JWT secret must be AT LEAST 32 characters. In production this is owned by
# the GitHub Actions environment / deploy host secret store. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<set-generated-csprng-value>

# Required for administrator TOTP seed encryption. Generate a 32-byte standard
# base64 value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in the deployment secret store; every API instance must receive the
# same value. Do not reuse a placeholder or commit a real key.
MFA_ENCRYPTION_KEY=<set-32-byte-base64-secret>

# The browser-facing origin of the frontend. Used for CORS.
# Production example: https://app.example.com
FRONTEND_ORIGIN=https://app.example.com

# Set to "true" once you're serving the frontend over HTTPS so the
# refresh-token cookie carries the Secure flag.
COOKIE_SECURE=true

# --- Trust proxy (M3-S3) ---
# Number of trusted proxy hops between the public internet and the
# server. In the bundled production stack nginx (the `web` service)
# sits in front of the server and sets X-Forwarded-For, so set this
# to 1 so express-rate-limit keys on the real client IP instead of
# the nginx container's internal IP. Set to false for direct
# connections (no proxy in front). Accepts a non-negative integer
# (hop count) or boolean.
TRUST_PROXY=1

# Base URL written into transactional email links (password reset,
# verify email). Falls back to FRONTEND_ORIGIN when unset. Override
# only when the link host differs from the CORS origin (e.g. behind
# a CDN with a separate hostname for outbound links).
APP_BASE_URL=https://app.example.com

# --- Auth performance / status cache (M3-A5) ---
# TTL (seconds) for the in-memory User.status LRU cache. 0 disables
# the cache (every protected request hits the DB — pre-M3 behavior).
# 60 is the production default; ban / unban / password-change paths
# invalidate explicitly, so TTL only bounds out-of-band mutations.
USER_STATUS_CACHE_TTL_SEC=60

# --- Object storage (P0-C) ---
# Required in production. The server refuses to boot if any of the
# four core values (ENDPOINT, BUCKET, ACCESS_KEY, SECRET_KEY) is
# missing while NODE_ENV=production.
#
# Self-hosted with the bundled MinIO (run with `COMPOSE_PROFILES=selfhost-storage`):
#   STORAGE_ENDPOINT=http://minio:9000
#   STORAGE_BUCKET=monexus-uploads
#   STORAGE_ACCESS_KEY=<set-minio-root-user>
#   STORAGE_SECRET_KEY=<set-minio-root-password>
#   STORAGE_PUBLIC_URL_BASE=https://cdn.example.com/monexus-uploads
#
# External S3 / R2 / OSS: point STORAGE_ENDPOINT at the provider URL
# and leave the `selfhost-storage` profile off.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=monexus-uploads
STORAGE_ACCESS_KEY=<set-storage-access-key>
STORAGE_SECRET_KEY=<set-storage-secret-key>
STORAGE_PUBLIC_URL_BASE=https://cdn.example.com/monexus-uploads
STORAGE_FORCE_PATH_STYLE=true

# --- P5 controlled file delivery (REQUIRED in production) ---
# Private bucket for paid delivery files. MUST differ from STORAGE_BUCKET
# (the public bucket carries an anonymous-download policy). The public
# endpoint is the browser-reachable https origin used ONLY for presigning
# download URLs (nginx passes /<bucket>/... through to MinIO verbatim).
# The server REFUSES to start in production without both values: the
# fallback is in-memory storage and paid files would vanish on restart.
DELIVERY_STORAGE_BUCKET=monexus-files
DELIVERY_STORAGE_PUBLIC_ENDPOINT=https://your-site.example.com

# --- Transactional email / SMTP (M3-A1) ---
# When SMTP_HOST is unset the server falls back to a console mailer
# (no real delivery). In production, SMTP_HOST must point to a real
# SMTP relay so password-reset / verify-email actually arrive.
#
# Provider snippets (consult provider docs for current values):
#   AWS SES SMTP: SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587 SMTP_SECURE=false
#   Mailtrap:     SMTP_HOST=sandbox.smtp.mailtrap.io            SMTP_PORT=2525 SMTP_SECURE=false
#   Gmail SMTP:   SMTP_HOST=smtp.gmail.com                      SMTP_PORT=465 SMTP_SECURE=true
#
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<set-provider-user>
SMTP_PASS=<set-provider-password-or-token>
SMTP_FROM=noreply@example.com

# --- Registration abuse protection (SPEC-RAP-001) ---
# Production always runs in `enforce` mode: public registration and user mail
# fail closed if Redis or Turnstile is unavailable. ABUSE_HASH_KEY is an
# independent 32-byte standard-base64 HMAC key used only to derive opaque
# Redis identifiers for emails/IPs; do not reuse JWT or MFA keys.
# Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ABUSE_PROTECTION_MODE=enforce
ABUSE_HASH_KEY=<set-32-byte-base64-secret>
# Turnstile site key may be public; the secret remains in the deployment
# secret store and must never be exposed to the browser or committed.
TURNSTILE_SITE_KEY=<set-turnstile-site-key>
TURNSTILE_SECRET_KEY=<set-turnstile-secret-key>
# Exact browser hostnames only: no scheme, path, port, wildcard, or URL.
TURNSTILE_ALLOWED_HOSTNAMES=app.example.com

# --- Error reporting (M2 GA; documented in M3) ---
# Backend Sentry / GlitchTip DSN. Errors are forwarded via @sentry/node.
# Leave unset in dev / staging if you don't want to ship events there.
SENTRY_DSN=https://<key>@<host>/<project>

# Frontend Sentry / GlitchTip DSN, baked in at Vite build time. Errors
# are forwarded via @sentry/react from the React error boundary plus
# the global handler in src/main.tsx. Leave unset in dev to silence.
VITE_SENTRY_DSN=https://<key>@<host>/<project>
#
# The current frontend calls the API through same-origin /api. The
# production nginx container proxies /api to the backend, so VITE_API_URL
# is not needed for docker-compose.prod.yml.

# --- Logging (M2 GA) ---
# pino log level: fatal | error | warn | info | debug | trace | silent.
# Defaults to "info". Raise temporarily when chasing an incident.
LOG_LEVEL=info

# --- Metrics endpoint protection (M4-A3) ---
# GET /api/metrics requires 'Authorization: Bearer <token>' and is required
# whenever NODE_ENV=production.
METRICS_TOKEN=<set-random-bearer-token>

# --- Redis cache and required abuse-protection store ---
# SPEC-RAP-001 makes Redis a fail-closed dependency for public registration
# and user mail only. All API instances must point at the same durable Redis
# namespace; do not set either flag false in production.
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=<set-strong-random-password>
REDIS_TLS=false
REDIS_REQUIRED=true
REDIS_CONNECT_TIMEOUT_MS=100
REDIS_COMMAND_TIMEOUT_MS=80
REDIS_CIRCUIT_ERROR_THRESHOLD=5
REDIS_CIRCUIT_OPEN_MS=30000
CACHE_KEY_PREFIX=monexus:prod
CACHE_PRODUCT_LIST=true
CACHE_PRODUCT_DETAIL=true
CACHE_PRODUCT_REVIEWS=true
CACHE_PRODUCT_LIST_VERSION_COALESCE_MS=10000
CACHE_MAX_VALUE_BYTES=524288

# --- Portable application backup / restore ---
# Complete encrypted backup bundles are created/downloaded by an administrator.
# The work directory is temporary; it does not contain an unencrypted retained backup.
PORTABLE_BACKUP_WORK_DIR=/tmp/monexus-portable-backups
# 2 GiB: raise only when the reverse proxy and free disk space support it.
PORTABLE_BACKUP_MAX_BYTES=2147483648
# Set only on a brand-new destination instance before importing. It enables
# the one-time /restore-setup page while no users exist; never reuse it.
PORTABLE_RESTORE_BOOTSTRAP_TOKEN=

# --- P7 merchant webhook auto-provisioning ---
# Required in production even before a merchant configures a webhook: it is
# the persistent AES-256-GCM key used to encrypt merchant signing secrets.
# Generate with: openssl rand -hex 32
# Never rotate it without resetting every stored merchant webhook configuration.
WEBHOOK_SECRET_ENC_KEY=<set-64-hex-secret>
# Development/test escape hatch only. Production refuses true because it
# disables HTTPS/IP-pinning SSRF protections for merchant webhook calls.
AUTO_PROVISION_ALLOW_INSECURE_TARGETS=false

# --- FakaBridge / Xboard subscription provision (optional) ---
# Leave unset until offers use externalIntegration=faka_bridge (M2+).
# When enabling, set BOTH URL and SECRET or the server refuses to boot.
# Production callback path has NO /api/v1 prefix (verified 2026-07-29).
# FAKA_BRIDGE_URL=https://v.uuwu.de/plugin/faka-bridge/order-paid
# FAKA_BRIDGE_STATUS_URL=https://v.uuwu.de/plugin/faka-bridge/order-status
# FAKA_BRIDGE_REVOKE_URL=https://v.uuwu.de/plugin/faka-bridge/order-revoke
# FAKA_BRIDGE_SECRET=<same as Xboard plugin hmac_secret — never commit>
# FAKA_BRIDGE_TIMEOUT_MS=5000
# FAKA_BRIDGE_MAX_ATTEMPTS=3
# FAKA_BRIDGE_PANEL_URL=https://v.uuwu.de
# FAKA_BRIDGE_ALLOW_INSECURE_TARGETS=false

# --- Encrypted backup / restore rehearsal ---
# The VPS Compose stack keeps PostgreSQL private, so use docker-compose here.
# Only the age *recipient* (public key) lives on the VPS; keep its matching
# age identity on an independent recovery system. The script refuses to write
# plaintext unless ALLOW_PLAINTEXT_BACKUP=true is set for a disposable drill.
BACKUP_SOURCE=docker-compose
BACKUP_COMPOSE_ENV_FILE=/opt/monexus/.env
BACKUP_COMPOSE_PROJECT_NAME=monexus-prod
BACKUP_AGE_RECIPIENT=age1<set-offsite-recovery-recipient>
# Snapshot the bundled MinIO bucket too. Set none only when storage is backed
# up independently by its managed provider.
BACKUP_OBJECT_MODE=compose-minio
# Optional offsite destination. Configure it as an rclone crypt remote.
# RCLONE_REMOTE=offsite-crypt:monexus
# Needed only when BACKUP_SOURCE=url, including the GitHub backup workflow.
BACKUP_DATABASE_URL=postgresql://monexus_backup:<password>@db.example.com:5432/monexus?sslmode=require
# This must always point at a non-production staging/restore database because
# scripts/restore-check.sh drops and recreates its public schema.
RESTORE_TARGET_URL=postgresql://monexus_restore:<password>@staging-db.example.com:5432/monexus_restore?sslmode=require

# --- Frontend container ---
# Host port exposed by docker-compose.prod.yml for the nginx web service.
# The VPS guide overrides this to a loopback-only, nonstandard port.
WEB_PORT=80

# --- Docker image deployment (GitHub Actions → GHCR → host pull) ---
# Tag to pull from GHCR for both monexus-server and monexus-web. Use a
# commit SHA for immutable deploys (recommended) or "latest" for the most
# recent master build. Override per-deploy via env to pin a release:
#   MONEXUS_IMAGE_TAG=sha-abc1234 docker compose ... up -d
MONEXUS_IMAGE_TAG=latest
# pull_policy: "missing" (default, use local or pull if absent) | "always"
# (force pull latest matching tag on every up) | "never" (require local image).
# Set to "always" when MONEXUS_IMAGE_TAG=latest to guarantee fresh code.
MONEXUS_PULL_POLICY=missing
